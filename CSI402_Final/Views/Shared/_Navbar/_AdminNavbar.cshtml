<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — MatchaBrew Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --sage: #5a7a5e;
            --sage-dark: #3d5940;
            --sage-darker: #2d4230;
            --sage-light: #8aab8e;
            --sage-glow: rgba(90,122,94,0.15);
            --cream: #f7f4ef;
            --warm-white: #fefcf8;
            --ink: #1e2420;
            --muted: #7a8878;
            --border: #d8e0d6;
            --sidebar-w: 256px;
            --danger: #c0392b;
            --warning: #d4850a;
            --success: #2e7d32;
            --topbar-h: 64px;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--cream);
            color: var(--ink);
            display: flex;
            min-height: 100vh;
        }

        /* ─── SIDEBAR ─────────────────────────────── */
        .sidebar {
            width: var(--sidebar-w);
            background: linear-gradient(180deg, var(--sage-darker) 0%, var(--sage-dark) 100%);
            min-height: 100vh;
            position: fixed;
            top: 0; left: 0;
            display: flex;
            flex-direction: column;
            z-index: 100;
            border-right: 1px solid rgba(255,255,255,0.05);
        }

        /* subtle texture overlay */
        .sidebar::before {
            content: '';
            position: absolute;
            inset: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.015'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
            pointer-events: none;
        }

        .sidebar-logo {
            padding: 28px 24px 22px;
            border-bottom: 1px solid rgba(255,255,255,0.07);
            position: relative;
        }

        .sidebar-logo .brand {
            font-family: 'Cormorant Garamond', serif;
            font-size: 22px;
            font-weight: 600;
            color: white;
            letter-spacing: 0.03em;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .brand-icon {
            width: 34px; height: 34px;
            background: rgba(255,255,255,0.12);
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 17px;
            border: 1px solid rgba(255,255,255,0.15);
        }

        .sidebar-logo .brand-sub {
            font-size: 10px;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--sage-light);
            margin-top: 6px;
            padding-left: 44px;
            opacity: 0.75;
        }

        /* ─── NAV ─────────────────────────────────── */
        .sidebar-nav { flex: 1; padding: 12px 0 8px; overflow-y: auto; }

        .nav-section-label {
            font-size: 9.5px;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.28);
            padding: 18px 24px 7px;
            font-weight: 500;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 10px 20px 10px 22px;
            color: rgba(255,255,255,0.6);
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 400;
            transition: all 0.18s ease;
            border-left: 3px solid transparent;
            margin: 1px 10px;
            border-radius: 9px;
            position: relative;
        }

        .nav-item:hover {
            color: white;
            background: rgba(255,255,255,0.07);
            border-left-color: transparent;
        }

        .nav-item.active {
            color: white;
            background: rgba(255,255,255,0.11);
            font-weight: 500;
        }

        .nav-item.active::before {
            content: '';
            position: absolute;
            left: -10px; top: 50%;
            transform: translateY(-50%);
            width: 3px; height: 22px;
            background: var(--sage-light);
            border-radius: 0 3px 3px 0;
        }

        .nav-item .icon {
            width: 32px; height: 32px;
            display: flex; align-items: center; justify-content: center;
            border-radius: 8px;
            font-size: 15px;
            background: rgba(255,255,255,0.06);
            flex-shrink: 0;
            transition: background 0.18s;
        }

        .nav-item:hover .icon,
        .nav-item.active .icon {
            background: rgba(255,255,255,0.13);
        }

        .nav-item .label { flex: 1; }

        /* ─── SIDEBAR FOOTER ─────────────────────── */
        .sidebar-footer {
            padding: 16px 14px;
            border-top: 1px solid rgba(255,255,255,0.07);
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        /* Back to Home button */
        .btn-home {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 9px 14px;
            border-radius: 9px;
            background: rgba(138,171,142,0.15);
            border: 1px solid rgba(138,171,142,0.25);
            color: var(--sage-light);
            font-size: 13px;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s;
        }

        .btn-home:hover {
            background: rgba(138,171,142,0.25);
            border-color: rgba(138,171,142,0.45);
            color: #c8e6c9;
        }

        .btn-home i { font-size: 14px; }

        .sidebar-user {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            background: rgba(255,255,255,0.04);
            border-radius: 10px;
            border: 1px solid rgba(255,255,255,0.06);
        }

        .user-avatar {
            width: 34px; height: 34px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--sage-light), var(--sage));
            display: flex; align-items: center; justify-content: center;
            font-size: 13px; font-weight: 600; color: white;
            flex-shrink: 0;
            border: 2px solid rgba(255,255,255,0.15);
        }

        .user-info { flex: 1; min-width: 0; }
        .user-info .name { font-size: 12.5px; font-weight: 500; color: white; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .user-info .role { font-size: 10.5px; color: var(--sage-light); margin-top: 1px; opacity: 0.8; }

        .btn-logout {
            display: flex;
            align-items: center;
            gap: 8px;
            width: 100%;
            padding: 9px 14px;
            background: transparent;
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 9px;
            color: rgba(255,255,255,0.45);
            font-size: 12.5px;
            font-family: 'DM Sans', sans-serif;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s;
        }

        .btn-logout:hover {
            background: rgba(192,57,43,0.15);
            border-color: rgba(192,57,43,0.3);
            color: #ff8a7a;
        }

        /* ─── MAIN AREA ───────────────────────────── */
        .main-wrap {
            margin-left: var(--sidebar-w);
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .top-bar {
            background: rgba(254,252,248,0.9);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border);
            padding: 0 32px;
            height: var(--topbar-h);
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0; z-index: 50;
        }

        .top-bar-left { display: flex; align-items: center; gap: 14px; }

        .page-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 23px;
            font-weight: 600;
            color: var(--ink);
            letter-spacing: 0.01em;
        }

        .breadcrumb-sep {
            color: var(--border);
            font-size: 18px;
            margin-top: 1px;
        }

        .top-bar-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .top-bar-date {
            font-size: 12.5px;
            color: var(--muted);
            display: flex;
            align-items: center;
            gap: 6px;
            background: var(--cream);
            padding: 6px 12px;
            border-radius: 20px;
            border: 1px solid var(--border);
        }

        .main-content { padding: 32px; flex: 1; }

        /* ─── SHARED COMPONENTS ───────────────────── */
        .card {
            background: white;
            border-radius: 16px;
            border: 1px solid var(--border);
            padding: 24px;
            margin-bottom: 24px;
            box-shadow: 0 1px 4px rgba(30,36,32,0.04);
        }

        .card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
        .card-title { font-family: 'Cormorant Garamond', serif; font-size: 20px; font-weight: 600; color: var(--ink); }

        .btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 18px; border-radius: 8px; font-size: 13px; font-weight: 500; font-family: 'DM Sans', sans-serif; cursor: pointer; text-decoration: none; border: none; transition: all 0.2s; }
        .btn-primary { background: var(--sage-dark); color: white; }
        .btn-primary:hover { background: var(--sage); transform: translateY(-1px); box-shadow: 0 4px 14px rgba(61,89,64,0.28); }
        .btn-outline { background: transparent; color: var(--sage-dark); border: 1.5px solid var(--border); }
        .btn-outline:hover { border-color: var(--sage); background: var(--cream); }
        .btn-danger { background: transparent; color: var(--danger); border: 1.5px solid #f5c6c3; }
        .btn-danger:hover { background: #fff0ef; }
        .btn-sm { padding: 6px 12px; font-size: 12px; }

        .badge { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 500; }
        .badge-success { background: #e8f5e9; color: var(--success); }
        .badge-warning { background: #fff3e0; color: var(--warning); }
        .badge-danger  { background: #fff0ef; color: var(--danger); }
        .badge-muted   { background: var(--cream); color: var(--muted); }
        .badge-coffee  { background: #fdf3e7; color: #7b4f2e; }
        .badge-matcha  { background: #eef5ee; color: var(--sage-dark); }
        .badge-equip   { background: #eef0f5; color: #3a4060; }

        table { width: 100%; border-collapse: collapse; }
        th { text-align: left; font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); padding: 0 16px 12px; border-bottom: 1px solid var(--border); }
        td { padding: 14px 16px; font-size: 14px; border-bottom: 1px solid var(--border); color: var(--ink); vertical-align: middle; }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: #fafcfa; }

        .form-group { margin-bottom: 16px; }
        .form-group label { display: block; font-size: 11px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 7px; }
        .form-control { width: 100%; height: 42px; border: 1.5px solid var(--border); border-radius: 8px; background: var(--cream); padding: 0 14px; font-family: 'DM Sans', sans-serif; font-size: 14px; color: var(--ink); outline: none; transition: all 0.2s; box-sizing: border-box; }
        textarea.form-control { height: auto; padding: 10px 14px; resize: vertical; }
        .form-control:focus { border-color: var(--sage); background: white; box-shadow: 0 0 0 3px rgba(90,122,94,0.10); }

        .alert { padding: 12px 16px; border-radius: 8px; font-size: 13px; margin-bottom: 16px; }
        .alert-success { background: #e8f5e9; color: var(--success); border: 1px solid #c8e6c9; }
        .alert-danger  { background: #fff0ef; color: var(--danger); border: 1px solid #f5c6c3; }
        .text-danger { font-size: 12px; color: var(--danger); display: block; margin-top: 4px; }

        /* MODAL */
        .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(30,36,32,0.45); z-index: 200; align-items: flex-start; justify-content: center; padding: 40px 20px; overflow-y: auto; backdrop-filter: blur(2px); }
        .modal-overlay.open { display: flex; }
        .modal-box { background: white; border-radius: 16px; padding: 32px; width: 580px; max-width: 95vw; box-shadow: 0 24px 64px rgba(0,0,0,0.15); margin: auto; }
        .modal-title { font-family: 'Cormorant Garamond', serif; font-size: 22px; font-weight: 600; margin-bottom: 20px; }
        .modal-footer { display: flex; gap: 10px; justify-content: flex-end; margin-top: 24px; }

        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .col-span-2 { grid-column: 1 / -1; }
        .detail-panel { border: 1.5px solid var(--border); border-radius: 10px; padding: 16px; background: var(--cream); margin-top: 4px; display: none; }
        .detail-panel.visible { display: block; }
        .detail-panel-title { font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 12px; }

        /* scrollbar */
        .sidebar-nav::-webkit-scrollbar { width: 3px; }
        .sidebar-nav::-webkit-scrollbar-track { background: transparent; }
        .sidebar-nav::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 3px; }
    </style>
</head>
<body>

<aside class="sidebar">
    <div class="sidebar-logo">
        <div class="brand">
            <div class="brand-icon">☕</div>
            MatchaBrew
        </div>
        <div class="brand-sub">Admin Panel</div>
    </div>

    <nav class="sidebar-nav">
        <div class="nav-section-label">Overview</div>
        <a href="/Admin/Dashboard" class="nav-item @(ViewData["ActivePage"]?.ToString()=="Dashboard"?"active":"")">
            <span class="icon"><i class="bi bi-grid-1x2"></i></span>
            <span class="label">Dashboard</span>
        </a>

        <div class="nav-section-label">Management</div>
        <a href="/Admin/Products" class="nav-item @(ViewData["ActivePage"]?.ToString()=="Products"?"active":"")">
            <span class="icon"><i class="bi bi-box-seam"></i></span>
            <span class="label">Products</span>
        </a>
        <a href="/Admin/Stock" class="nav-item @(ViewData["ActivePage"]?.ToString()=="Stock"?"active":"")">
            <span class="icon"><i class="bi bi-archive"></i></span>
            <span class="label">Stock</span>
        </a>
        <a href="/Admin/Orders" class="nav-item @(ViewData["ActivePage"]?.ToString()=="Orders"?"active":"")">
            <span class="icon"><i class="bi bi-receipt"></i></span>
            <span class="label">Orders</span>
        </a>
        <a href="/Admin/Users" class="nav-item @(ViewData["ActivePage"]?.ToString()=="Users"?"active":"")">
            <span class="icon"><i class="bi bi-people"></i></span>
            <span class="label">Users</span>
        </a>
        <a href="/Admin/Coupons" class="nav-item @(ViewData["ActivePage"]?.ToString()=="Coupons"?"active":"")">
            <span class="icon"><i class="bi bi-ticket-perforated"></i></span>
            <span class="label">Coupons</span>
        </a>
    </nav>

    <div class="sidebar-footer">
        @* Back to Home *@
        <a href="/" class="btn-home">
            <i class="bi bi-house-door"></i>
            Back to Store
        </a>

        <div class="sidebar-user">
            <div class="user-avatar">A</div>
            <div class="user-info">
                <div class="name">@(Context.Session.GetString("Email") ?? "Admin")</div>
                <div class="role">Administrator</div>
            </div>
        </div>

        <a href="/Auth/Logout" class="btn-logout">
            <i class="bi bi-box-arrow-left"></i> Sign out
        </a>
    </div>
</aside>

<div class="main-wrap">
    <div class="top-bar">
        <div class="top-bar-left">
            <div class="page-title">@ViewData["Title"]</div>
        </div>
        <div class="top-bar-right">
            <div class="top-bar-date">
                <i class="bi bi-calendar3" style="color:var(--sage)"></i>
                @DateTime.Now.ToString("dd MMM yyyy")
            </div>
        </div>
    </div>
    <div class="main-content">@RenderBody()</div>
</div>

<script>
function openModal(id)  { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }
document.addEventListener('keydown', e => {
    if (e.key === 'Escape') document.querySelectorAll('.modal-overlay.open').forEach(m => m.classList.remove('open'));
});
function showTypeDetail(val, prefix) {
    ['coffee','matcha','equipment'].forEach(t => {
        var el = document.getElementById(prefix + '-' + t);
        if (el) el.style.display = (t === val) ? 'block' : 'none';
    });
}
</script>
</body>
</html>
