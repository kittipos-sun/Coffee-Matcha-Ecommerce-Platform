<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bamboo</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300&family=DM+Sans:opsz,wght@@9..40,300;9..40,400;9..40,500&display=swap" rel="stylesheet">

    <style>
        :root {
            --sage: #5a7a5e;
            --sage-dark: #3d5940;
            --sage-light: #8aab8e;
            --sage-mist: rgba(90, 122, 94, 0.07);
            --cream: #f7f4ef;
            --cream-deep: #f0ece4;
            --warm-white: #fefcf8;
            --ink: #1a1f1b;
            --ink-soft: #2e3830;
            --muted: #7a8878;
            --muted-light: #a8b5a6;
            --border: #dce4da;
            --border-soft: #eaefe9;
            --gold: #c9a96e;
            --shadow-sm: 0 2px 12px rgba(30, 36, 32, 0.06);
            --shadow-md: 0 8px 32px rgba(30, 36, 32, 0.10);
        }

        *, *::before, *::after { box-sizing: border-box; }

        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            font-family: 'DM Sans', sans-serif;
            background: var(--warm-white);
            color: var(--ink);
            -webkit-font-smoothing: antialiased;
        }

        /* ─────────────────── NAVBAR ─────────────────── */
        .navbar-custom {
            height: 80px;
            padding: 0 52px;
            background: rgba(254, 252, 248, 0.97);
            backdrop-filter: blur(20px) saturate(1.4);
            -webkit-backdrop-filter: blur(20px) saturate(1.4);
            border-bottom: 1px solid var(--border-soft);
            position: sticky;
            top: 0;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: box-shadow 0.3s ease;
        }

        .navbar-custom.scrolled {
            box-shadow: var(--shadow-sm);
        }

        /* Logo */
        .nav-logo {
            font-family: 'Cormorant Garamond', serif;
            font-size: 26px;
            font-weight: 600;
            color: var(--ink);
            text-decoration: none;
            letter-spacing: 0.05em;
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
        }

        .nav-logo:hover { color: var(--ink); text-decoration: none; }

        .nav-logo-mark {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--sage) 0%, var(--sage-dark) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            box-shadow: 0 2px 8px rgba(61, 89, 64, 0.28);
        }

        .nav-logo-mark svg {
            width: 14px;
            height: 14px;
            fill: none;
            stroke: white;
            stroke-width: 1.8;
        }

        /* Nav links */
        .nav-links {
            display: flex;
            align-items: center;
            gap: 2px;
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
        }

        .nav-links a {
            font-size: 14px;
            font-weight: 400;
            color: var(--muted);
            text-decoration: none;
            padding: 7px 16px;
            border-radius: 100px;
            transition: all 0.2s ease;
            letter-spacing: 0.02em;
            white-space: nowrap;
        }

        .nav-links a:hover {
            color: var(--ink);
            background: var(--sage-mist);
        }

        .nav-links a.active {
            color: var(--sage-dark);
            font-weight: 500;
            background: var(--sage-mist);
        }

        /* Right section */
        .nav-right {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
        }

        /* Cart button */
        .btn-cart-nav {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: var(--cream);
            border: 1px solid var(--border);
            color: var(--ink-soft);
            font-size: 17px;
            text-decoration: none;
            transition: all 0.22s ease;
            flex-shrink: 0;
        }

        .btn-cart-nav:hover {
            background: var(--sage-dark);
            border-color: var(--sage-dark);
            color: white;
            text-decoration: none;
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(61, 89, 64, 0.24);
        }

        .btn-cart-nav i { font-size: 17px; line-height: 1; }

        .cart-badge {
            position: absolute;
            top: -3px;
            right: -3px;
            width: 17px;
            height: 17px;
            border-radius: 50%;
            background: #d4603c;
            color: white;
            font-size: 9px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid var(--warm-white);
            line-height: 1;
        }

        /* User pill */
        .user-pill {
            display: flex;
            align-items: center;
            gap: 9px;
            background: var(--cream);
            border: 1px solid var(--border);
            border-radius: 100px;
            padding: 6px 14px 6px 6px;
            transition: border-color 0.2s;
        }

        .user-pill:hover { border-color: var(--muted-light); }

        .user-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--sage) 0%, var(--sage-dark) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 13px;
            flex-shrink: 0;
        }

        .user-email-text {
            font-size: 13.5px;
            color: var(--ink-soft);
            font-weight: 400;
            max-width: 150px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            letter-spacing: 0.01em;
        }

        /* Admin badge */
        .btn-admin {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 500;
            font-family: 'DM Sans', sans-serif;
            color: var(--gold);
            text-decoration: none;
            padding: 7px 14px;
            border-radius: 100px;
            border: 1px solid rgba(201, 169, 110, 0.35);
            background: rgba(201, 169, 110, 0.08);
            transition: all 0.2s ease;
            letter-spacing: 0.02em;
            white-space: nowrap;
        }

        .btn-admin:hover {
            background: rgba(201, 169, 110, 0.16);
            border-color: rgba(201, 169, 110, 0.6);
            color: #b8904e;
            text-decoration: none;
            transform: translateY(-1px);
        }

        .btn-admin i { font-size: 13px; }

        /* Divider */
        .nav-divider {
            width: 1px;
            height: 22px;
            background: var(--border);
            flex-shrink: 0;
        }

        /* Logout */
        .btn-logout {
            font-size: 13.5px;
            color: var(--muted);
            text-decoration: none;
            padding: 7px 16px;
            border-radius: 100px;
            border: 1px solid var(--border);
            background: transparent;
            transition: all 0.2s ease;
            cursor: pointer;
            font-family: 'DM Sans', sans-serif;
            letter-spacing: 0.01em;
            white-space: nowrap;
        }

        .btn-logout:hover {
            color: var(--ink);
            border-color: var(--muted-light);
            background: var(--cream);
            text-decoration: none;
        }

        /* Sign In */
        .btn-signin {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: var(--sage-dark);
            color: white;
            font-family: 'DM Sans', sans-serif;
            font-size: 14px;
            font-weight: 500;
            padding: 10px 24px;
            border-radius: 100px;
            text-decoration: none;
            transition: all 0.22s ease;
            border: none;
            letter-spacing: 0.02em;
            white-space: nowrap;
        }

        .btn-signin:hover {
            background: var(--sage);
            color: white;
            text-decoration: none;
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(61, 89, 64, 0.26);
        }

        /* ─────────────────── MAIN ─────────────────── */
        .main-content { flex: 1; }

        /* ─────────────────── FOOTER ─────────────────── */
        .site-footer {
            background: var(--ink);
            color: rgba(255,255,255,0.65);
            padding: 88px 56px 48px;
            margin-top: auto;
        }

        .footer-inner {
            max-width: 1200px;
            margin: 0 auto;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 60px;
            margin-bottom: 64px;
        }

        .footer-brand-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 26px;
            font-weight: 600;
            color: white;
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            letter-spacing: 0.04em;
        }

        .footer-brand-mark {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--sage-light), var(--sage));
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .footer-brand-mark svg {
            width: 12px; height: 12px;
            fill: none; stroke: white; stroke-width: 1.8;
        }

        .footer-brand-desc {
            font-size: 14.5px;
            line-height: 1.75;
            color: rgba(255,255,255,0.42);
            font-weight: 300;
            max-width: 240px;
        }

        .footer-col-title {
            font-size: 11px;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.3);
            font-weight: 500;
            margin-bottom: 20px;
        }

        .footer-links {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 13px;
        }

        .footer-links a {
            font-size: 14.5px;
            color: rgba(255,255,255,0.55);
            text-decoration: none;
            transition: color 0.2s;
        }

        .footer-links a:hover { color: white; }

        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.07);
            padding-top: 36px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 13px;
            color: rgba(255,255,255,0.28);
        }

        .footer-jp {
            font-size: 13px;
            letter-spacing: 0.14em;
            color: rgba(255,255,255,0.2);
        }

        /* Scroll shadow JS hook */
        @@media (max-width: 900px) {
            .navbar-custom { padding: 0 24px; height: 72px; }
            .nav-links { display: none; }
            .footer-grid { grid-template-columns: 1fr 1fr; gap: 36px; }
            .site-footer { padding: 52px 24px 32px; }
        }

        @@media (max-width: 520px) {
            .footer-grid { grid-template-columns: 1fr; }
            .footer-bottom { flex-direction: column; gap: 10px; text-align: center; }
            .user-email-text { max-width: 100px; }
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar-custom" id="mainNav">

        <a class="nav-logo" href="/">
            <span class="nav-logo-mark">
                <svg viewBox="0 0 14 14" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7 2 C7 2 4 4 4 7 C4 10 7 12 7 12 C7 12 10 10 10 7 C10 4 7 2 7 2Z" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </span>
            Bamboo
        </a>

        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/Product">Products</a>
            <a href="/Product?category=Coffee Beans">Coffee</a>
            <a href="/Product?category=Matcha">Matcha</a>
            <a href="/Product?category=Equipment">Equipment</a>
            <a href="/Order/Track">My Orders</a>
        </div>

        <div class="nav-right">
            @{
                var userId = Context.Session.GetString("UserID");
                var email = Context.Session.GetString("Email");
                var role = Context.Session.GetString("Role");
            }

            @if (userId != null)
            {
                <!-- Cart -->
                <a href="/Cart" class="btn-cart-nav" title="Cart">
                    <i class="bi bi-bag"></i>
                </a>

                @if (role == "admin")
                {
                    <!-- Admin Dashboard -->
                    <a href="/Admin/Dashboard" class="btn-admin">
                        <i class="bi bi-speedometer2"></i>
                        Dashboard
                    </a>
                }

                <!-- User Info -->
                <div class="user-pill">
                    <div class="user-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <span class="user-email-text">@email</span>
                </div>

                <span class="nav-divider"></span>

                <!-- Logout -->
                <a href="/Auth/Logout" class="btn-logout">Logout</a>
            }
            else
            {
                <!-- Cart (guest) -->
                <a href="/Cart" class="btn-cart-nav" title="Cart">
                    <i class="bi bi-bag"></i>
                </a>

                <!-- Sign In -->
                <a href="/Auth/Login" class="btn-signin">
                    Sign In
                </a>
            }
        </div>

    </nav>

    <!-- CONTENT -->
    <main class="main-content">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="site-footer">
        <div class="footer-inner">

            <div class="footer-grid">

                <div>
                    <div class="footer-brand-name">
                        <span class="footer-brand-mark">
                            <svg viewBox="0 0 14 14" xmlns="http://www.w3.org/2000/svg">
                                <path d="M7 2 C7 2 4 4 4 7 C4 10 7 12 7 12 C7 12 10 10 10 7 C10 4 7 2 7 2Z" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                        Bamboo
                    </div>
                    <p class="footer-brand-desc">
                        Premium coffee and ceremonial-grade matcha, thoughtfully sourced from Japan and beyond for mindful moments.
                    </p>
                </div>

                <div>
                    <div class="footer-col-title">Shop</div>
                    <ul class="footer-links">
                        <li><a href="/Product?category=Coffee Beans">Coffee</a></li>
                        <li><a href="/Product?category=Matcha">Matcha</a></li>
                        <li><a href="/Product?category=Equipment">Equipment</a></li>
                        <li><a href="/Product">All Products</a></li>
                    </ul>
                </div>

                <div>
                    <div class="footer-col-title">Company</div>
                    <ul class="footer-links">
                        <li><a href="#">About</a></li>
                        <li><a href="#">Contact</a></li>
                        <li><a href="#">Shipping</a></li>
                    </ul>
                </div>

                <div>
                    <div class="footer-col-title">Support</div>
                    <ul class="footer-links">
                        <li><a href="#">FAQ</a></li>
                        <li><a href="#">Returns</a></li>
                        <li><a href="#">Privacy</a></li>
                    </ul>
                </div>

            </div>

            <div class="footer-bottom">
                <span>© @DateTime.Now.Year Bamboo. All rights reserved.</span>
                <span class="footer-jp">日本のこだわり · Japanese Craftsmanship</span>
            </div>

        </div>
    </footer>

    <script>
        // Add shadow to navbar on scroll
        const nav = document.getElementById('mainNav');
        window.addEventListener('scroll', () => {
            nav.classList.toggle('scrolled', window.scrollY > 12);
        }, { passive: true });

        // Mark active nav link
        const links = document.querySelectorAll('.nav-links a');
        links.forEach(link => {
            if (link.href === window.location.href) link.classList.add('active');
        });
    </script>

</body>
</html>
