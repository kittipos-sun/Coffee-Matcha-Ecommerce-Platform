@model CSI402_Final.Models.DB.Order

@{
    ViewData["Title"] = "Order Placed!";
    Layout = "~/Views/Shared/_Navbar/_UserNavbar.cshtml";

    decimal total = Model.OrdersItems?.Sum(i => i.Price ?? 0) ?? 0;
}

<style>
    :root {
        --sage:      #5a7a5e;
        --sage-dark: #3d5940;
        --sage-light:#8aab8e;
        --cream:     #f7f4ef;
        --warm-white:#fefcf8;
        --ink:       #1e2420;
        --muted:     #7a8878;
        --border:    #d8e0d6;
    }

    body { font-family: 'DM Sans', sans-serif; background: var(--warm-white); color: var(--ink); }

    .success-page {
        max-width: 680px;
        margin: 72px auto;
        padding: 0 24px 80px;
        text-align: center;
    }

    .success-icon {
        width: 88px; height: 88px;
        border-radius: 50%;
        background: rgba(90,122,94,0.12);
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 28px;
        font-size: 40px;
    }

    .success-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 38px;
        font-weight: 600;
        color: var(--ink);
        margin-bottom: 12px;
    }

    .success-sub {
        font-size: 15px;
        color: var(--muted);
        margin-bottom: 8px;
    }

    .order-id-badge {
        display: inline-block;
        background: var(--cream);
        border: 1px solid var(--border);
        border-radius: 100px;
        padding: 6px 18px;
        font-size: 12px;
        letter-spacing: 0.08em;
        color: var(--muted);
        margin-top: 12px;
        margin-bottom: 40px;
    }

    .order-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 32px;
        text-align: left;
        margin-bottom: 24px;
    }

    .order-card-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 20px;
        font-weight: 600;
        color: var(--ink);
        margin-bottom: 20px;
    }

    .order-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid var(--border);
        font-size: 14px;
    }
    .order-item:last-child { border-bottom: none; }
    .oi-name { color: var(--ink); font-weight: 500; }
    .oi-meta { font-size: 12px; color: var(--muted); margin-top: 2px; }
    .oi-price {
        font-family: 'Cormorant Garamond', serif;
        font-size: 18px;
        font-weight: 600;
        color: var(--sage-dark);
    }

    .total-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 0 0;
        border-top: 1px solid var(--border);
        margin-top: 4px;
        font-size: 15px;
        font-weight: 600;
        color: var(--ink);
    }
    .total-row .total-val {
        font-family: 'Cormorant Garamond', serif;
        font-size: 30px;
        font-weight: 600;
        color: var(--sage-dark);
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(90,122,94,0.1);
        color: var(--sage-dark);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 5px 14px;
        border-radius: 100px;
        margin-bottom: 20px;
    }
    .status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--sage); }

    .actions { display: flex; gap: 12px; justify-content: center; margin-top: 12px; flex-wrap: wrap; }

    .btn-primary {
        display: inline-flex; align-items: center; gap: 8px;
        background: var(--sage-dark); color: white;
        font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 500;
        padding: 13px 28px; border-radius: 100px;
        text-decoration: none; transition: all 0.25s;
    }
    .btn-primary:hover {
        background: var(--sage);
        transform: translateY(-2px);
        box-shadow: 0 10px 24px rgba(61,89,64,0.22);
        color: white; text-decoration: none;
    }

    .btn-outline {
        display: inline-flex; align-items: center; gap: 8px;
        border: 1.5px solid var(--border); color: var(--muted);
        font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 500;
        padding: 13px 28px; border-radius: 100px;
        text-decoration: none; transition: all 0.2s; background: white;
    }
    .btn-outline:hover { border-color: var(--sage); color: var(--sage); text-decoration: none; }
</style>

<div class="success-page">

    <div class="success-icon">✅</div>

    <h1 class="success-title">Order Placed!</h1>
    <p class="success-sub">Thank you for your order. We'll start preparing it right away.</p>

    <div class="order-id-badge">
        ORDER #@Model.OrderId.Substring(0, 8).ToUpper()
    </div>

    <!-- Status -->
    <div>
        <span class="status-badge">
            <span class="status-dot"></span>
            @Model.Status
        </span>
    </div>

    <!-- Items summary -->
    <div class="order-card">
        <div class="order-card-title">Items Ordered</div>

        @foreach (var oi in Model.OrdersItems ?? new List<CSI402_Final.Models.DB.OrdersItem>())
        {
            var prod = oi.ProductOption?.Product;
            <div class="order-item">
                <div>
                    <div class="oi-name">@prod?.ProductName</div>
                    <div class="oi-meta">Qty: @oi.Amount</div>
                </div>
                <div class="oi-price">@((oi.Price ?? 0).ToString("N0")) ฿</div>
            </div>
        }

        <div class="total-row">
            <span>Total Paid</span>
            <span class="total-val">@((Model.TotalPrice ?? 0).ToString("N0")) ฿</span>
        </div>
    </div>

    <div class="actions">
        <a href="/Product" class="btn-primary">
            <i class="bi bi-bag"></i> Continue Shopping
        </a>
        <a href="/Cart" class="btn-outline">
            <i class="bi bi-house"></i> Back to Home
        </a>
    </div>

</div>
