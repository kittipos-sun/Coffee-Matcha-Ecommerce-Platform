@model List<CSI402_Final.Models.DB.CartItem>

@{
    ViewData["Title"] = "Your Cart";
    Layout = "~/Views/Shared/_Navbar/_UserNavbar.cshtml";

    var total = Model.Sum(i => (i.ProductOption?.ProductPrice ?? 0) * (i.CartItemAmount ?? 0));
    var itemCount = Model.Sum(i => i.CartItemAmount ?? 0);
}

<style>
    :root {
        --sage: #5a7a5e;
        --sage-dark: #3d5940;
        --sage-light: #8aab8e;
        --cream: #f7f4ef;
        --warm-white: #fefcf8;
        --ink: #1e2420;
        --muted: #7a8878;
        --border: #d8e0d6;
        --section-bg: #f3f0eb;
    }

    body { font-family: 'DM Sans', sans-serif; background: var(--warm-white); color: var(--ink); }

    /* ── PAGE HEADER ── */
    .page-header {
        background: var(--sage-dark);
        padding: 48px 60px 44px;
        position: relative;
        overflow: hidden;
    }

    .page-header::before {
        content: '';
        position: absolute;
        top: -80px; right: -80px;
        width: 300px; height: 300px;
        border-radius: 50%;
        background: rgba(255,255,255,0.04);
        pointer-events: none;
    }

    .header-inner {
        max-width: 1200px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
    }

    .header-label {
        font-size: 11px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--sage-light);
        font-weight: 500;
        margin-bottom: 10px;
    }

    .header-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 40px;
        font-weight: 600;
        color: white;
        margin: 0;
        line-height: 1.05;
    }

    .header-sub {
        font-size: 14px;
        color: rgba(255,255,255,0.5);
        margin-top: 8px;
        font-weight: 300;
    }

    /* ── LAYOUT ── */
    .cart-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 48px 60px 80px;
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 40px;
        align-items: start;
    }

    /* ── CART ITEMS ── */
    .cart-items-wrap { display: flex; flex-direction: column; gap: 0; }

    .section-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 22px;
        font-weight: 600;
        color: var(--ink);
        margin-bottom: 20px;
    }

    .cart-item {
        display: grid;
        grid-template-columns: 88px 1fr auto;
        gap: 20px;
        align-items: center;
        padding: 22px 0;
        border-bottom: 1px solid var(--border);
    }

    .cart-item:first-of-type { border-top: 1px solid var(--border); }

    .item-img {
        width: 88px;
        height: 88px;
        border-radius: 14px;
        overflow: hidden;
        background: linear-gradient(145deg, #e0e8e1, #c8d8ca);
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        position: relative;
    }

    .item-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        position: absolute;
        inset: 0;
        border-radius: 14px;
    }

    .item-info { min-width: 0; }

    .item-type {
        font-size: 10px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--sage);
        font-weight: 500;
        margin-bottom: 4px;
    }

    .item-name {
        font-family: 'Cormorant Garamond', serif;
        font-size: 20px;
        font-weight: 600;
        color: var(--ink);
        line-height: 1.2;
        margin-bottom: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .item-option {
        font-size: 13px;
        color: var(--muted);
    }

    .item-right {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 12px;
        flex-shrink: 0;
    }

    .item-price {
        font-family: 'Cormorant Garamond', serif;
        font-size: 22px;
        font-weight: 600;
        color: var(--sage-dark);
        white-space: nowrap;
    }

    /* Qty controls inline */
    .qty-row {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .qty-form { display: flex; align-items: center; }

    .qty-wrap {
        display: flex;
        align-items: center;
        border: 1.5px solid var(--border);
        border-radius: 10px;
        background: var(--cream);
        overflow: hidden;
        height: 36px;
    }

    .qty-btn {
        width: 34px;
        height: 100%;
        border: none;
        background: transparent;
        font-size: 18px;
        color: var(--muted);
        cursor: pointer;
        transition: background 0.15s;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-family: 'DM Sans', sans-serif;
        line-height: 1;
    }

    .qty-btn:hover { background: var(--border); color: var(--ink); }

    .qty-num {
        width: 38px;
        text-align: center;
        font-size: 14px;
        font-weight: 500;
        color: var(--ink);
        border: none;
        background: transparent;
        font-family: 'DM Sans', sans-serif;
        pointer-events: none;
    }

    .remove-btn {
        background: none;
        border: none;
        color: var(--muted);
        cursor: pointer;
        font-size: 16px;
        padding: 4px;
        border-radius: 6px;
        transition: all 0.15s;
        display: flex;
        align-items: center;
        line-height: 1;
    }

    .remove-btn:hover { color: #c0392b; background: #fff0ef; }

    /* ── SUMMARY ── */
    .cart-summary {
        background: white;
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 32px;
        position: sticky;
        top: 108px;
    }

    .summary-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 22px;
        font-weight: 600;
        color: var(--ink);
        margin-bottom: 24px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 14px;
        color: var(--muted);
        padding: 10px 0;
    }

    .summary-row.total {
        border-top: 1px solid var(--border);
        margin-top: 8px;
        padding-top: 18px;
        font-size: 16px;
        color: var(--ink);
        font-weight: 500;
    }

    .summary-row.total .summary-val {
        font-family: 'Cormorant Garamond', serif;
        font-size: 28px;
        font-weight: 600;
        color: var(--sage-dark);
    }

    .free-shipping {
        background: rgba(90,122,94,0.08);
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 12px;
        color: var(--sage-dark);
        margin: 16px 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-checkout {
        width: 100%;
        height: 52px;
        border: none;
        border-radius: 12px;
        background: var(--sage-dark);
        color: white;
        font-family: 'DM Sans', sans-serif;
        font-size: 15px;
        font-weight: 500;
        letter-spacing: 0.04em;
        cursor: pointer;
        transition: all 0.25s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 20px;
        text-decoration: none;
    }

    .btn-checkout:hover {
        background: var(--sage);
        transform: translateY(-2px);
        box-shadow: 0 10px 28px rgba(61,89,64,0.25);
        color: white;
        text-decoration: none;
    }

    .btn-clear {
        width: 100%;
        height: 42px;
        border: 1.5px solid var(--border);
        border-radius: 10px;
        background: transparent;
        color: var(--muted);
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.2s;
        margin-top: 10px;
    }

    .btn-clear:hover { border-color: #c0392b; color: #c0392b; background: #fff0ef; }

    /* ── EMPTY STATE ── */
    .empty-cart {
        grid-column: 1 / -1;
        text-align: center;
        padding: 100px 20px;
    }

    .empty-icon { font-size: 64px; margin-bottom: 20px; }

    .empty-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 32px;
        font-weight: 400;
        font-style: italic;
        color: var(--muted);
        margin-bottom: 12px;
    }

    .empty-sub {
        font-size: 14px;
        color: var(--muted);
        margin-bottom: 32px;
    }

    .btn-shop {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--sage-dark);
        color: white;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        font-weight: 500;
        padding: 13px 28px;
        border-radius: 100px;
        text-decoration: none;
        transition: all 0.25s;
    }

    .btn-shop:hover {
        background: var(--sage);
        transform: translateY(-2px);
        box-shadow: 0 10px 24px rgba(61,89,64,0.22);
        color: white;
        text-decoration: none;
    }

    @@media (max-width: 900px) {
        .cart-page { grid-template-columns: 1fr; padding: 32px 24px 60px; }
        .cart-summary { position: static; }
        .page-header { padding: 40px 24px 36px; }
    }

    @@media (max-width: 540px) {
        .cart-item { grid-template-columns: 72px 1fr; }
        .item-right { grid-column: 1 / -1; flex-direction: row; justify-content: space-between; align-items: center; }
    }
</style>

<!-- PAGE HEADER -->
<div class="page-header">
    <div class="header-inner">
        <div class="header-label">My Order</div>
        <h1 class="header-title">Shopping Cart</h1>
        <p class="header-sub">
            @if (Model.Any())
            {
                <text>@itemCount item@(itemCount != 1 ? "s" : "") in your cart</text>
            }
            else
            {
                <text>Your cart is empty</text>
            }
        </p>
    </div>
</div>

@if (!Model.Any())
{
    <!-- EMPTY STATE -->
    <div style="max-width:1200px; margin:0 auto; padding:0 60px;">
        <div class="empty-cart">
            <div class="empty-icon">🛍️</div>
            <div class="empty-title">Your cart is empty</div>
            <p class="empty-sub">Looks like you haven't added anything yet.</p>
            <a href="/Product" class="btn-shop">Browse Collection →</a>
        </div>
    </div>
}
else
{
    <div class="cart-page">

        <!-- CART ITEMS -->
        <div class="cart-items-wrap">
            <div class="section-title">Items (@Model.Count)</div>

            @foreach (var item in Model)
            {
                var opt  = item.ProductOption;
                var prod = opt?.Product;
                var itemType = prod?.ProductType?.ToLower() ?? "";
                string imgUrl = itemType.Contains("coffee")
                    ? Url.Content("~/images/coffee-beans.jpg")
                    : itemType.Contains("matcha")
                    ? Url.Content("~/images/matcha-powder.jpg")
                    : Url.Content("~/images/brewing-equipment.jpg");
                decimal lineTotal = (opt?.ProductPrice ?? 0) * (item.CartItemAmount ?? 0);

                <div class="cart-item">

                    <!-- Image -->
                    <div class="item-img">
                        <img src="@imgUrl" alt="@prod?.ProductName" onerror="this.style.display='none'" />
                        <span>🍵</span>
                    </div>

                    <!-- Info -->
                    <div class="item-info">
                        <div class="item-type">@prod?.ProductType</div>
                        <div class="item-name">@prod?.ProductName</div>
                        <div class="item-option">@opt?.ProductAmount @opt?.ProductUnit · @opt?.ProductPrice?.ToString("N0") ฿ each</div>
                    </div>

                    <!-- Right: price + qty + remove -->
                    <div class="item-right">

                        <div class="item-price">@lineTotal.ToString("N0") ฿</div>

                        <div class="qty-row">
                            <!-- Qty form -->
                            <form method="post" asp-action="UpdateQuantity" asp-controller="Cart" class="qty-form">
                                <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                <input type="hidden" name="quantity" id="qtyVal_@item.CartItemId" value="@item.CartItemAmount" />

                                <div class="qty-wrap">
                                    <button type="submit" class="qty-btn"
                                            onclick="adjustQty('@item.CartItemId', -1)">−</button>
                                    <span class="qty-num" id="qtyDisplay_@item.CartItemId">@item.CartItemAmount</span>
                                    <button type="submit" class="qty-btn"
                                            onclick="adjustQty('@item.CartItemId', 1)">+</button>
                                </div>
                            </form>

                            <!-- Remove -->
                            <form method="post" asp-action="Remove" asp-controller="Cart">
                                <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                <button type="submit" class="remove-btn" title="Remove">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </form>
                        </div>

                    </div>

                </div>
            }
        </div>

        <!-- ORDER SUMMARY -->
        <div class="cart-summary">
            <div class="summary-title">Order Summary</div>

            <div class="summary-row">
                <span>Subtotal (@itemCount item@(itemCount != 1 ? "s" : ""))</span>
                <span>@total.ToString("N0") ฿</span>
            </div>

            <div class="summary-row">
                <span>Shipping</span>
                <span>@(total >= 500 ? "Free" : "50 ฿")</span>
            </div>

            @if (total < 500)
            {
                <div class="free-shipping">
                    🌿 Add @((500 - total).ToString("N0")) ฿ more for free shipping
                </div>
            }
            else
            {
                <div class="free-shipping">
                    ✓ You qualify for free shipping!
                </div>
            }

            <div class="summary-row total">
                <span>Total</span>
                <span class="summary-val">@((total + (total >= 500 ? 0 : 50)).ToString("N0")) ฿</span>
            </div>

            <a href="/Order/Checkout" class="btn-checkout">
                <i class="bi bi-bag-check"></i> Proceed to Checkout
            </a>

            <form method="post" asp-action="Clear" asp-controller="Cart">
                <button type="submit" class="btn-clear">Clear Cart</button>
            </form>
        </div>

    </div>
}

<script>
    function adjustQty(id, delta) {
        const valInput = document.getElementById('qtyVal_' + id);
        const display  = document.getElementById('qtyDisplay_' + id);
        let current = parseInt(valInput.value) || 1;
        current = Math.max(0, current + delta); // 0 = remove
        valInput.value      = current;
        display.textContent = current === 0 ? '0' : current;
    }
</script>
