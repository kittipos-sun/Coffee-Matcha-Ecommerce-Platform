@using CSI402_Final.Models.DB
@model Product

@{
    ViewData["Title"] = "Product Detail";
    ViewData["ActivePage"] = "Products";
    Layout = "~/Views/Shared/_Navbar/_AdminNavbar.cshtml";
    var ptype = (Model.ProductType ?? "").ToLower();
}

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"]   != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<!-- Product Info Card -->
<div class="card">
    <div class="card-header">
        <div>
            <a href="/Admin/Products" style="font-size:13px;color:var(--muted);text-decoration:none">← Back to Products</a>
            <div class="card-title" style="margin-top:4px">@Model.ProductName</div>
        </div>
        <button class="btn btn-outline" onclick="openModal('editProductModal')">Edit Info</button>
    </div>

    <div style="display:grid;grid-template-columns:auto 1fr;gap:24px;align-items:start">
        <!-- Thumbnail -->
        <div style="width:100px;height:100px;border-radius:12px;overflow:hidden;border:1px solid var(--border);background:var(--cream);display:flex;align-items:center;justify-content:center;font-size:40px">
            @if (!string.IsNullOrEmpty(Model.ProductImage) && Model.ProductImage != "img")
            {
                <img src="@Model.ProductImage" style="width:100%;height:100%;object-fit:cover" />
            }
            else
            {
                @(ptype == "coffee" ? "☕" : ptype == "matcha" ? "🍵" : "🔧")
            }
        </div>

        <div>
            <div style="display:flex;gap:8px;margin-bottom:8px">
                <span class="badge @(ptype=="coffee"?"badge-coffee":ptype=="matcha"?"badge-matcha":"badge-equip")">@Model.ProductType</span>
                <span class="badge badge-muted">@(Model.Category?.CategoryName)</span>
            </div>
            <p style="font-size:14px;color:var(--muted);line-height:1.6">@(Model.ProductDescription ?? "No description.")</p>

            <!-- Type Detail Display -->
            @if (ptype == "coffee" && Model.ProductCoffeeDetail != null)
            {
                var d = Model.ProductCoffeeDetail;
                <div style="display:flex;gap:16px;margin-top:12px;flex-wrap:wrap">
                    @if (!string.IsNullOrEmpty(d.Origin))     { <span style="font-size:12px;color:var(--ink)">🌍 <b>Origin:</b> @d.Origin</span> }
                    @if (!string.IsNullOrEmpty(d.RoastLevel)) { <span style="font-size:12px;color:var(--ink)">🔥 <b>Roast:</b> @d.RoastLevel</span> }
                    @if (!string.IsNullOrEmpty(d.FlavorNote)) { <span style="font-size:12px;color:var(--ink)">✨ <b>Flavor:</b> @d.FlavorNote</span> }
                    @if (!string.IsNullOrEmpty(d.Process))    { <span style="font-size:12px;color:var(--ink)">⚙ <b>Process:</b> @d.Process</span> }
                </div>
            }
            @if (ptype == "matcha" && Model.ProductMatchaDetail != null)
            {
                var d = Model.ProductMatchaDetail;
                <div style="display:flex;gap:16px;margin-top:12px;flex-wrap:wrap">
                    @if (!string.IsNullOrEmpty(d.Grade))      { <span style="font-size:12px;color:var(--ink)">🏅 <b>Grade:</b> @d.Grade</span> }
                    @if (!string.IsNullOrEmpty(d.Origin))     { <span style="font-size:12px;color:var(--ink)">🌍 <b>Origin:</b> @d.Origin</span> }
                    @if (!string.IsNullOrEmpty(d.ColorLevel)) { <span style="font-size:12px;color:var(--ink)">🎨 <b>Color:</b> @d.ColorLevel</span> }
                </div>
            }
            @if (ptype == "equipment" && Model.ProductEquipmentDetail != null)
            {
                var d = Model.ProductEquipmentDetail;
                <div style="display:flex;gap:16px;margin-top:12px;flex-wrap:wrap">
                    @if (!string.IsNullOrEmpty(d.Brand))         { <span style="font-size:12px;color:var(--ink)">🏷 <b>Brand:</b> @d.Brand</span> }
                    @if (!string.IsNullOrEmpty(d.EquipmentType)) { <span style="font-size:12px;color:var(--ink)">🔧 <b>Type:</b> @d.EquipmentType</span> }
                    @if (!string.IsNullOrEmpty(d.Material))      { <span style="font-size:12px;color:var(--ink)">🪨 <b>Material:</b> @d.Material</span> }
                </div>
            }
        </div>
    </div>
</div>

<!-- Product Options -->
<div class="card">
    <div class="card-header">
        <div class="card-title">Product Options</div>
        <button class="btn btn-primary" onclick="openModal('addOptionModal')">＋ Add Option</button>
    </div>

    <table>
        <thead>
            <tr><th>Unit / Size</th><th>Amount</th><th>Price</th><th>Stock</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var opt in Model.ProductOptions)
            {
                <tr>
                    <td style="font-weight:500">@opt.ProductUnit</td>
                    <td style="color:var(--muted)">@opt.ProductAmount</td>
                    <td>฿@String.Format("{0:N0}", opt.ProductPrice)</td>
                    <td>
                        <span class="badge @(opt.ProductStock==0?"badge-danger":opt.ProductStock<=10?"badge-warning":"badge-success")">
                            @opt.ProductStock
                        </span>
                    </td>
                    <td>
                        <div style="display:flex;gap:6px">
                            <button class="btn btn-outline btn-sm"
                                onclick="openEditOption('@opt.ProductOptionId','@opt.ProductUnit','@opt.ProductAmount','@opt.ProductPrice','@opt.ProductStock')">
                                Edit
                            </button>
                            <form method="post" action="/Admin/DeleteOption" onsubmit="return confirm('Delete this option?')">
                                <input type="hidden" name="optionId" value="@opt.ProductOptionId" />
                                <input type="hidden" name="productId" value="@Model.ProductId" />
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.ProductOptions.Any())
            {
                <tr><td colspan="5" style="text-align:center;color:var(--muted);padding:32px">No options yet. Add one above.</td></tr>
            }
        </tbody>
    </table>
</div>

<!-- ================================================================ -->
<!-- ADD OPTION MODAL -->
<!-- ================================================================ -->
<div class="modal-overlay" id="addOptionModal">
    <div class="modal-box" style="width:420px">
        <div class="modal-title">Add Option</div>
        <form method="post" action="/Admin/AddOption">
            <input type="hidden" name="productId" value="@Model.ProductId" />
            <div class="form-group"><label>Unit / Size</label><input name="ProductUnit" class="form-control" placeholder="e.g. 250g" required /></div>
            <div class="grid-2">
                <div class="form-group"><label>Price (฿)</label><input name="ProductPrice" type="number" step="0.01" min="0" class="form-control" required /></div>
                <div class="form-group"><label>Stock</label><input name="ProductStock" type="number" min="0" class="form-control" value="0" required /></div>
                <div class="form-group"><label>Amount per unit</label><input name="ProductAmount" type="number" min="1" class="form-control" value="1" /></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeModal('addOptionModal')">Cancel</button>
                <button type="submit" class="btn btn-primary">Add</button>
            </div>
        </form>
    </div>
</div>

<!-- ================================================================ -->
<!-- EDIT OPTION MODAL -->
<!-- ================================================================ -->
<div class="modal-overlay" id="editOptionModal">
    <div class="modal-box" style="width:420px">
        <div class="modal-title">Edit Option</div>
        <form method="post" action="/Admin/EditOption">
            <input type="hidden" name="ProductOptionId" id="eo-id" />
            <input type="hidden" name="ProductId" value="@Model.ProductId" />
            <div class="form-group"><label>Unit / Size</label><input id="eo-unit" name="ProductUnit" class="form-control" required /></div>
            <div class="grid-2">
                <div class="form-group"><label>Price (฿)</label><input id="eo-price" name="ProductPrice" type="number" step="0.01" min="0" class="form-control" required /></div>
                <div class="form-group"><label>Stock</label><input id="eo-stock" name="ProductStock" type="number" min="0" class="form-control" required /></div>
                <div class="form-group"><label>Amount per unit</label><input id="eo-amount" name="ProductAmount" type="number" min="1" class="form-control" /></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeModal('editOptionModal')">Cancel</button>
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>

<!-- ================================================================ -->
<!-- EDIT PRODUCT INFO MODAL (รวม Detail + Image Upload) -->
<!-- ================================================================ -->
<div class="modal-overlay" id="editProductModal">
    <div class="modal-box" style="max-width:560px">
        <div class="modal-title">Edit Product Info</div>

        @* enctype multipart สำหรับ upload รูป *@
        <form method="post" action="/Admin/EditProduct" enctype="multipart/form-data">
            <input type="hidden" name="ProductId"   value="@Model.ProductId" />
            <input type="hidden" name="ProductType" value="@Model.ProductType" />

            <!-- Basic Info -->
            <div class="form-group">
                <label>Product Name</label>
                <input name="ProductName" class="form-control" value="@Model.ProductName" required />
            </div>

            <div class="form-group">
                <label>Description</label>
                <textarea name="ProductDescription" class="form-control" rows="3">@Model.ProductDescription</textarea>
            </div>

            <!-- Image Section -->
            <div style="border:1px solid var(--border);border-radius:12px;padding:16px;margin-bottom:16px">
                <div style="font-size:11px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);margin-bottom:12px">📷 Product Image</div>

                <div style="margin-bottom:14px;display:flex;align-items:center;gap:14px">
                    <div style="width:72px;height:72px;border-radius:10px;overflow:hidden;border:1px solid var(--border);background:var(--cream);display:flex;align-items:center;justify-content:center;font-size:32px;flex-shrink:0">
                        @if (!string.IsNullOrEmpty(Model.ProductImage) && Model.ProductImage != "img")
                        {
                            <img id="imgPreview" src="@Model.ProductImage" style="width:100%;height:100%;object-fit:cover" />
                        }
                        else
                        {
                            <span id="imgEmoji">@(ptype == "coffee" ? "☕" : ptype == "matcha" ? "🍵" : "🔧")</span>
                            <img id="imgPreview" style="width:100%;height:100%;object-fit:cover;display:none" />
                        }
                    </div>
                    <div>
                        <div style="font-size:13px;font-weight:500;margin-bottom:2px">
                            @if (!string.IsNullOrEmpty(Model.ProductImage) && Model.ProductImage != "img")
                            { <span>รูปปัจจุบัน</span> }
                            else
                            { <span style="color:var(--muted)">ยังไม่มีรูป</span> }
                        </div>
                        <div style="font-size:11px;color:var(--muted)">ถ้าไม่เลือกไฟล์ใหม่ จะใช้รูปเดิม</div>
                    </div>
                </div>

                <div class="form-group" style="margin-bottom:0">
                    <label>อัพโหลดรูปใหม่ <span style="font-weight:400;color:var(--muted)">(ไม่บังคับ)</span></label>
                    <input name="ProductImageFile" type="file" accept="image/jpeg,image/png,image/webp,image/gif"
                           class="form-control" onchange="previewImg(this)" />
                    <div style="font-size:11px;color:var(--muted);margin-top:4px">JPG · PNG · WebP · GIF &nbsp;|&nbsp; แนะนำไม่เกิน 2 MB</div>
                </div>
            </div>

            <!-- Type-specific Detail -->
            @if (ptype == "coffee")
            {
                <div style="border:1px solid var(--border);border-radius:12px;padding:16px;margin-bottom:16px">
                    <div style="font-size:11px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);margin-bottom:12px">☕ Coffee Details</div>
                    <div class="grid-2">
                        <div class="form-group">
                            <label>Origin</label>
                            <input name="CoffeeOrigin" class="form-control" value="@Model.ProductCoffeeDetail?.Origin" />
                        </div>
                        <div class="form-group">
                            <label>Roast Level</label>
                            <select name="RoastLevel" class="form-control">
                                <option value="">—</option>
                                @foreach (var r in new[]{"Light","Medium","Medium-Dark","Dark"})
                                {
                                    if (Model.ProductCoffeeDetail?.RoastLevel == r)
                                    {
                                        <option value="@r" selected>@r</option>
                                    }
                                    else
                                    {
                                        <option value="@r">@r</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Flavor Notes</label>
                            <input name="FlavorNote" class="form-control" value="@Model.ProductCoffeeDetail?.FlavorNote" />
                        </div>
                        <div class="form-group">
                            <label>Process</label>
                            <input name="CoffeeProcess" class="form-control" value="@Model.ProductCoffeeDetail?.Process" />
                        </div>
                    </div>
                </div>
            }
            else if (ptype == "matcha")
            {
                <div style="border:1px solid var(--border);border-radius:12px;padding:16px;margin-bottom:16px">
                    <div style="font-size:11px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);margin-bottom:12px">🍵 Matcha Details</div>
                    <div class="grid-2">
                        <div class="form-group">
                            <label>Grade</label>
                            <input name="MatchaGrade" class="form-control" value="@Model.ProductMatchaDetail?.Grade" />
                        </div>
                        <div class="form-group">
                            <label>Origin</label>
                            <input name="MatchaOrigin" class="form-control" value="@Model.ProductMatchaDetail?.Origin" />
                        </div>
                        <div class="form-group">
                            <label>Color Level</label>
                            <input name="ColorLevel" class="form-control" value="@Model.ProductMatchaDetail?.ColorLevel" />
                        </div>
                    </div>
                </div>
            }
            else if (ptype == "equipment")
            {
                <div style="border:1px solid var(--border);border-radius:12px;padding:16px;margin-bottom:16px">
                    <div style="font-size:11px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);margin-bottom:12px">🔧 Equipment Details</div>
                    <div class="grid-2">
                        <div class="form-group">
                            <label>Brand</label>
                            <input name="Brand" class="form-control" value="@Model.ProductEquipmentDetail?.Brand" />
                        </div>
                        <div class="form-group">
                            <label>Equipment Type</label>
                            <input name="EquipmentType" class="form-control" value="@Model.ProductEquipmentDetail?.EquipmentType" />
                        </div>
                        <div class="form-group">
                            <label>Material</label>
                            <input name="Material" class="form-control" value="@Model.ProductEquipmentDetail?.Material" />
                        </div>
                    </div>
                </div>
            }

            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeModal('editProductModal')">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<script>
function openEditOption(id, unit, amount, price, stock) {
    document.getElementById('eo-id').value     = id;
    document.getElementById('eo-unit').value   = unit;
    document.getElementById('eo-amount').value = amount;
    document.getElementById('eo-price').value  = price;
    document.getElementById('eo-stock').value  = stock;
    openModal('editOptionModal');
}

// Preview รูปก่อน upload — ซ่อน emoji แสดงรูปจริง
function previewImg(input) {
    if (!input.files || !input.files[0]) return;
    const reader = new FileReader();
    reader.onload = e => {
        const img   = document.getElementById('imgPreview');
        const emoji = document.getElementById('imgEmoji');
        if (img)   { img.src = e.target.result; img.style.display = 'block'; }
        if (emoji) { emoji.style.display = 'none'; }
    };
    reader.readAsDataURL(input.files[0]);
}
</script>
