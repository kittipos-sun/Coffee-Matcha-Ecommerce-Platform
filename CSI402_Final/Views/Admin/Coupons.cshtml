@using CSI402_Final.Models.DB
@model IEnumerable<DiscountCoupon>
@{
    ViewData["Title"]      = "Coupon Management";
    ViewData["ActivePage"] = "Coupons";
    Layout = "~/Views/Shared/_Navbar/_AdminNavbar.cshtml";
}

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"]   != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<style>
    .badge-type {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.05em;
    }
    .badge-PERCENT  { background: #e8f5e9; color: #2e7d32; }
    .badge-FIXED    { background: #e3f2fd; color: #1565c0; }
    .badge-FREESHIP { background: #f3e5f5; color: #6a1b9a; }
    .badge-BOGO     { background: #fff8e1; color: #e65100; }
    .badge-MINSPEND { background: #fce4ec; color: #880e4f; }

    .coupon-desc { font-size: 12px; color: var(--muted); margin-top: 2px; }
    .toggle-inactive { opacity: 0.45; }

    /* field groups shown/hidden by JS */
    .field-group { display: none; }
    .field-group.show { display: block; }

    /* modal overlay */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 1000;
        background: rgba(0,0,0,0.45);
        align-items: center;
        justify-content: center;
    }
    .modal-overlay.open {
        display: flex;
    }
</style>

<!-- ── HEADER ── -->
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;">
    <div>
        <h2 style="margin:0;font-family:'Cormorant Garamond',serif;font-size:28px;">Coupon Management</h2>
        <p style="margin:4px 0 0;color:var(--muted);font-size:13px;">@Model.Count() coupon(s) total</p>
    </div>
    <button class="btn btn-primary" onclick="openAddModal()">
        <i class="bi bi-plus-lg"></i> New Coupon
    </button>
</div>

<!-- ── TABLE ── -->
<div class="card">
    <table>
        <thead>
            <tr>
                <th>Code / Name</th>
                <th>Type</th>
                <th>Discount Detail</th>
                <th>Left</th>
                <th>Used</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var c in Model)
        {
            bool active = c.IsActive ?? false;
            string typeDesc = c.DiscountType?.ToUpper() switch
            {
                "PERCENT"   => $"ลด {c.DiscountAmount:0}%",
                "FIXED"     => $"ลด {c.DiscountAmount:N0} ฿",
                "FREESHIP"  => "ฟรีค่าจัดส่ง",
                "BOGO"      => "ซื้อ 1 แถม 1",
                "MINSPEND"  => $"ซื้อครบ {c.DiscountPrice:N0} ฿ → ลด {c.DiscountAmount:N0} ฿",
                _           => c.DiscountType ?? "—"
            };

            <tr class="@(!active ? "toggle-inactive" : "")">
                <td>
                    <strong style="font-family:monospace;letter-spacing:0.05em;">@c.DiscountCode</strong>
                    <div class="coupon-desc">@c.DiscountName</div>
                </td>
                <td>
                    <span class="badge-type badge-@(c.DiscountType?.ToUpper())">@c.DiscountType</span>
                </td>
                <td>@typeDesc</td>
                <td>@c.DiscountLeft</td>
                <td>@c.Users.Count</td>
                <td>
                    @if (active)
                    {
                        <span style="color:#2e7d32;font-weight:600;font-size:12px;">● Active</span>
                    }
                    else
                    {
                        <span style="color:#999;font-size:12px;">○ Inactive</span>
                    }
                </td>
                <td>
                    <div style="display:flex;gap:6px;flex-wrap:wrap;">
                        <!-- Edit -->
                        <button class="btn btn-sm btn-outline"
                                onclick="openEditModal(
                                    '@c.DiscountId',
                                    '@c.DiscountName',
                                    '@c.DiscountCode',
                                    '@c.DiscountType?.ToUpper()',
                                    '@(c.DiscountPrice?.ToString() ?? "")',
                                    '@(c.DiscountAmount?.ToString() ?? "")',
                                    @c.DiscountLeft,
                                    @(active ? "true" : "false"))">
                            <i class="bi bi-pencil"></i> Edit
                        </button>
                        <!-- Toggle -->
                        <form method="post" asp-action="ToggleCoupon" style="margin:0;">
                            <input type="hidden" name="discountId" value="@c.DiscountId" />
                            <button type="submit" class="btn btn-sm @(active ? "btn-outline" : "btn-primary")">
                                <i class="bi bi-@(active ? "pause" : "play")"></i> @(active ? "Disable" : "Enable")
                            </button>
                        </form>
                        <!-- Delete -->
                        <form method="post" asp-action="DeleteCoupon" style="margin:0;"
                              onsubmit="return confirm('ลบคูปอง @c.DiscountCode ?')">
                            <input type="hidden" name="discountId" value="@c.DiscountId" />
                            <button type="submit" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="7" style="text-align:center;color:var(--muted);padding:40px;">ยังไม่มีคูปอง</td></tr>
        }
        </tbody>
    </table>
</div>

<!-- ================================================================ -->
<!-- ADD MODAL -->
<!-- ================================================================ -->
<div id="addModal" class="modal-overlay">
    <div style="background:white;border-radius:20px;padding:36px;width:520px;max-width:95vw;max-height:90vh;overflow-y:auto;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
            <h3 style="margin:0;font-family:'Cormorant Garamond',serif;">New Coupon</h3>
            <button onclick="closeModal('addModal')" style="background:none;border:none;font-size:20px;cursor:pointer;color:#888;">✕</button>
        </div>
        <form method="post" asp-action="AddCoupon">
            @Html.AntiForgeryToken()
            <div class="form-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                <div class="form-group full" style="grid-column:1/-1;">
                    <label class="form-label">ชื่อคูปอง</label>
                    <input class="form-control" name="DiscountName" required placeholder="New User 10%" />
                </div>
                <div class="form-group">
                    <label class="form-label">รหัสคูปอง</label>
                    <input class="form-control" name="DiscountCode" required placeholder="NEW10"
                           style="text-transform:uppercase;" oninput="this.value=this.value.toUpperCase()" />
                </div>
                <div class="form-group">
                    <label class="form-label">จำนวนสิทธิ์</label>
                    <input class="form-control" name="DiscountLeft" type="number" min="1" value="50" required />
                </div>

                <div class="form-group full" style="grid-column:1/-1;">
                    <label class="form-label">ประเภทคูปอง</label>
                    <select class="form-control" name="DiscountType" id="addType" onchange="onTypeChange('add')" required>
                        <option value="">— เลือกประเภท —</option>
                        <option value="PERCENT">PERCENT — ลด %</option>
                        <option value="FIXED">FIXED — ลดราคาคงที่ ฿</option>
                        <option value="FREESHIP">FREESHIP — ฟรีค่าจัดส่ง</option>
                        <option value="BOGO">BOGO — ซื้อ 1 แถม 1</option>
                        <option value="MINSPEND">MINSPEND — ลด ฿ เมื่อซื้อครบ</option>
                    </select>
                </div>

                <!-- PERCENT -->
                <div class="form-group full field-group" id="add-field-percent" style="grid-column:1/-1;">
                    <label class="form-label">% ที่ลด (1–100)</label>
                    <input class="form-control" name="DiscountAmount" id="add-discountAmount-percent"
                           type="number" step="0.01" min="1" max="100" placeholder="10" />
                </div>

                <!-- FIXED -->
                <div class="form-group full field-group" id="add-field-fixed" style="grid-column:1/-1;">
                    <label class="form-label">จำนวน ฿ ที่ลด</label>
                    <input class="form-control" name="DiscountAmount" id="add-discountAmount-fixed"
                           type="number" step="0.01" min="1" placeholder="100" />
                </div>

                <!-- MINSPEND -->
                <div class="form-group field-group" id="add-field-minspend-price" style="">
                    <label class="form-label">ยอดซื้อขั้นต่ำ (฿)</label>
                    <input class="form-control" name="DiscountPrice" id="add-discountPrice"
                           type="number" step="0.01" min="1" placeholder="1000" />
                </div>
                <div class="form-group field-group" id="add-field-minspend-amount" style="">
                    <label class="form-label">จำนวน ฿ ที่ลด</label>
                    <input class="form-control" name="DiscountAmount" id="add-discountAmount-minspend"
                           type="number" step="0.01" min="1" placeholder="200" />
                </div>

                <div class="form-group full" style="grid-column:1/-1;display:flex;align-items:center;gap:10px;">
                    <input type="checkbox" name="IsActive" value="true" id="addIsActive" checked style="width:18px;height:18px;" />
                    <label for="addIsActive" style="font-size:14px;margin:0;">เปิดใช้งานทันที</label>
                </div>
            </div>

            <div style="display:flex;gap:10px;margin-top:24px;justify-content:flex-end;">
                <button type="button" class="btn btn-outline" onclick="closeModal('addModal')">ยกเลิก</button>
                <button type="submit" class="btn btn-primary">สร้างคูปอง</button>
            </div>
        </form>
    </div>
</div>

<!-- ================================================================ -->
<!-- EDIT MODAL -->
<!-- ================================================================ -->
<div id="editModal" class="modal-overlay">
    <div style="background:white;border-radius:20px;padding:36px;width:520px;max-width:95vw;max-height:90vh;overflow-y:auto;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
            <h3 style="margin:0;font-family:'Cormorant Garamond',serif;">Edit Coupon</h3>
            <button onclick="closeModal('editModal')" style="background:none;border:none;font-size:20px;cursor:pointer;color:#888;">✕</button>
        </div>
        <form method="post" asp-action="EditCoupon">
            @Html.AntiForgeryToken()
            <input type="hidden" name="DiscountId" id="edit-id" />
            <div class="form-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                <div class="form-group full" style="grid-column:1/-1;">
                    <label class="form-label">ชื่อคูปอง</label>
                    <input class="form-control" name="DiscountName" id="edit-name" required />
                </div>
                <div class="form-group">
                    <label class="form-label">รหัสคูปอง</label>
                    <input class="form-control" name="DiscountCode" id="edit-code" required
                           style="text-transform:uppercase;" oninput="this.value=this.value.toUpperCase()" />
                </div>
                <div class="form-group">
                    <label class="form-label">จำนวนสิทธิ์คงเหลือ</label>
                    <input class="form-control" name="DiscountLeft" id="edit-left" type="number" min="0" required />
                </div>

                <div class="form-group full" style="grid-column:1/-1;">
                    <label class="form-label">ประเภทคูปอง</label>
                    <select class="form-control" name="DiscountType" id="editType" onchange="onTypeChange('edit')" required>
                        <option value="PERCENT">PERCENT — ลด %</option>
                        <option value="FIXED">FIXED — ลดราคาคงที่ ฿</option>
                        <option value="FREESHIP">FREESHIP — ฟรีค่าจัดส่ง</option>
                        <option value="BOGO">BOGO — ซื้อ 1 แถม 1</option>
                        <option value="MINSPEND">MINSPEND — ลด ฿ เมื่อซื้อครบ</option>
                    </select>
                </div>

                <!-- PERCENT -->
                <div class="form-group full field-group" id="edit-field-percent" style="grid-column:1/-1;">
                    <label class="form-label">% ที่ลด (1–100)</label>
                    <input class="form-control" name="DiscountAmount" id="edit-discountAmount-percent"
                           type="number" step="0.01" min="1" max="100" />
                </div>

                <!-- FIXED -->
                <div class="form-group full field-group" id="edit-field-fixed" style="grid-column:1/-1;">
                    <label class="form-label">จำนวน ฿ ที่ลด</label>
                    <input class="form-control" name="DiscountAmount" id="edit-discountAmount-fixed"
                           type="number" step="0.01" min="1" />
                </div>

                <!-- MINSPEND -->
                <div class="form-group field-group" id="edit-field-minspend-price">
                    <label class="form-label">ยอดซื้อขั้นต่ำ (฿)</label>
                    <input class="form-control" name="DiscountPrice" id="edit-discountPrice"
                           type="number" step="0.01" min="1" />
                </div>
                <div class="form-group field-group" id="edit-field-minspend-amount">
                    <label class="form-label">จำนวน ฿ ที่ลด</label>
                    <input class="form-control" name="DiscountAmount" id="edit-discountAmount-minspend"
                           type="number" step="0.01" min="1" />
                </div>

                <div class="form-group full" style="grid-column:1/-1;display:flex;align-items:center;gap:10px;">
                    <input type="checkbox" name="IsActive" value="true" id="editIsActive" style="width:18px;height:18px;" />
                    <label for="editIsActive" style="font-size:14px;margin:0;">เปิดใช้งาน</label>
                </div>
            </div>

            <div style="display:flex;gap:10px;margin-top:24px;justify-content:flex-end;">
                <button type="button" class="btn btn-outline" onclick="closeModal('editModal')">ยกเลิก</button>
                <button type="submit" class="btn btn-primary">บันทึก</button>
            </div>
        </form>
    </div>
</div>

<script>
// ── Modal helpers ──
function openAddModal() {
    document.getElementById('addModal').classList.add('open');
    onTypeChange('add'); // reset fields
}
function closeModal(id) {
    document.getElementById(id).classList.remove('open');
}

// ── Show/hide input fields by coupon type ──
const typeFields = {
    PERCENT:  ['percent'],
    FIXED:    ['fixed'],
    FREESHIP: [],
    BOGO:     [],
    MINSPEND: ['minspend-price', 'minspend-amount']
};

function onTypeChange(prefix) {
    const sel   = document.getElementById(prefix + 'Type');
    const type  = sel ? sel.value.toUpperCase() : '';
    const show  = typeFields[type] || [];

    // Hide all
    ['percent','fixed','minspend-price','minspend-amount'].forEach(f => {
        const el = document.getElementById(prefix + '-field-' + f);
        if (el) el.style.display = 'none';
    });

    // Show relevant
    show.forEach(f => {
        const el = document.getElementById(prefix + '-field-' + f);
        if (el) el.style.display = 'block';
    });
}

// ── Open edit modal & populate ──
function openEditModal(id, name, code, type, price, amount, left, active) {
    document.getElementById('edit-id').value   = id;
    document.getElementById('edit-name').value = name;
    document.getElementById('edit-code').value = code;
    document.getElementById('edit-left').value = left;
    document.getElementById('editIsActive').checked = active;

    const sel = document.getElementById('editType');
    sel.value = type;
    onTypeChange('edit');

    // Populate amount/price by type
    const t = type.toUpperCase();
    if (t === 'PERCENT') {
        document.getElementById('edit-discountAmount-percent').value = amount;
    } else if (t === 'FIXED') {
        document.getElementById('edit-discountAmount-fixed').value = amount;
    } else if (t === 'MINSPEND') {
        document.getElementById('edit-discountPrice').value = price;
        document.getElementById('edit-discountAmount-minspend').value = amount;
    }

    document.getElementById('editModal').classList.add('open');
}

// Close modal when clicking backdrop
['addModal','editModal'].forEach(id => {
    document.getElementById(id).addEventListener('click', function(e) {
        if (e.target === this) closeModal(id);
    });
});
</script>
