@using CSI402_Final.Models.DB
@model IEnumerable<User>

@{
    ViewData["Title"] = "User Management";
    ViewData["ActivePage"] = "Users";
    Layout = "~/Views/Shared/_Navbar/_AdminNavbar.cshtml";
}

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"]   != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<div class="card">
    <div class="card-header">
        <div class="card-title">All Users <span style="font-size:14px;color:var(--muted);font-family:'DM Sans',sans-serif;font-weight:400">(@Model.Count())</span></div>
    </div>
    <table>
        <thead>
            <tr><th>User</th><th>Phone</th><th>Role</th><th>Joined</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>
                        <div style="display:flex;align-items:center;gap:10px">
                            <div style="width:32px;height:32px;border-radius:50%;background:var(--sage-light);display:flex;align-items:center;justify-content:center;color:white;font-size:12px;font-weight:600;flex-shrink:0">
                                @(!string.IsNullOrEmpty(u.Email) ? u.Email.Substring(0,1).ToUpper() : "?")
                            </div>
                            <div>
                                <div style="font-weight:500">@u.Email</div>
                                <div style="font-size:11px;color:var(--muted)">@(u.UserId != null ? u.UserId.Substring(0, Math.Min(8, u.UserId.Length)) : "—")…</div>
                            </div>
                        </div>
                    </td>
                    <td style="color:var(--muted);font-size:13px">@(u.Phone ?? "—")</td>
                    <td>
                        <span class="badge @(u.Role=="admin"?"badge-warning":"badge-success")">@u.Role</span>
                    </td>
                    <td style="font-size:13px;color:var(--muted)">@u.CreatedAt?.ToString("dd MMM yyyy")</td>
                    <td>
                        <div style="display:flex;gap:6px;flex-wrap:wrap">
                            <!-- Edit User Button -->
                            <button class="btn btn-outline btn-sm"
                                onclick="openEditUser('@u.UserId','@u.Email','@(u.Phone ?? "")')">
                                Edit
                            </button>
                            <!-- Change Role -->
                            <form method="post" action="/Admin/ChangeRole">
                                <input type="hidden" name="userId" value="@u.UserId" />
                                <input type="hidden" name="newRole" value="@(u.Role=="admin"?"member":"admin")" />
                                <button type="submit" class="btn btn-outline btn-sm">
                                    → @(u.Role == "admin" ? "Make Member" : "Make Admin")
                                </button>
                            </form>
                            <!-- Delete -->
                            <form method="post" action="/Admin/DeleteUser" onsubmit="return confirm('Delete this user permanently?')">
                                <input type="hidden" name="userId" value="@u.UserId" />
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- EDIT USER MODAL -->
<div class="modal-overlay" id="editUserModal">
    <div class="modal-box" style="width:440px">
        <div class="modal-title">Edit User</div>
        <form method="post" action="/Admin/EditUser">
            <input type="hidden" name="UserId" id="eu-id" />

            <div class="form-group">
                <label>Email</label>
                <input id="eu-email" name="Email" type="email" class="form-control" required />
            </div>

            <div class="form-group">
                <label>Phone</label>
                <input id="eu-phone" name="Phone" type="tel" class="form-control" placeholder="e.g. 0812345678" />
            </div>

            <div class="form-group">
                <label>New Password <span style="font-size:11px;color:var(--muted);font-weight:400">(leave blank to keep current)</span></label>
                <div style="position:relative">
                    <input id="eu-password" name="NewPassword" type="password" class="form-control"
                           placeholder="Enter new password…" style="padding-right:40px" />
                    <button type="button"
                            onclick="togglePwd()"
                            style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--muted);font-size:14px"
                            title="Show/hide password">👁</button>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeModal('editUserModal')">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<script>
function openEditUser(id, email, phone) {
    document.getElementById('eu-id').value    = id;
    document.getElementById('eu-email').value = email;
    document.getElementById('eu-phone').value = phone;
    document.getElementById('eu-password').value = '';
    openModal('editUserModal');
}

function togglePwd() {
    const input = document.getElementById('eu-password');
    input.type = input.type === 'password' ? 'text' : 'password';
}
</script>
