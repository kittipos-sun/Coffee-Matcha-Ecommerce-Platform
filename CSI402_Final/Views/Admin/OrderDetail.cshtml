@using CSI402_Final.Models.DB
@model Order
@{
    ViewData["Title"] = "Order Detail";
    Layout = "~/Views/Shared/_Navbar/_AdminNavbar.cshtml";

    var statusMap = new Dictionary<string, (string label, string color, string icon)>
    {
        ["PENDING"]   = ("Pending",   "#b45309", "clock-history"),
        ["CONFIRMED"] = ("Confirmed", "#1d4ed8", "check2-circle"),
        ["SHIPPED"]   = ("Shipped",   "#0369a1", "truck"),
        ["COMPLETED"] = ("Completed", "#15803d", "bag-check-fill"),
        ["CANCELLED"] = ("Cancelled", "#b91c1c", "x-circle-fill"),
    };
    var currentStatus = Model.Status ?? "PENDING";
    var (statusLabel, statusColor, statusIcon) = statusMap.ContainsKey(currentStatus)
        ? statusMap[currentStatus]
        : ("Unknown", "#6b7280", "question-circle");

    var allStatuses = new[] { "PENDING", "CONFIRMED", "SHIPPED", "COMPLETED", "CANCELLED" };
}

<style>
    :root {
        --sage:       #5a7a5e;
        --sage-dark:  #3d5940;
        --sage-light: #8aab8e;
        --cream:      #f7f4ef;
        --warm-white: #fefcf8;
        --ink:        #1e2420;
        --muted:      #7a8878;
        --border:     #d8e0d6;
        --danger:     #c0392b;
        --success:    #2d7a4f;
    }
    body { font-family: 'DM Sans', sans-serif; background: var(--cream); color: var(--ink); }

    /* ── PAGE HEADER ── */
    .page-header {
        background: var(--sage-dark);
        padding: 40px 60px 36px;
        position: relative;
        overflow: hidden;
    }
    .page-header::before {
        content: '';
        position: absolute;
        top: -80px; right: -80px;
        width: 280px; height: 280px;
        border-radius: 50%;
        background: rgba(255,255,255,0.04);
        pointer-events: none;
    }
    .header-inner { max-width: 1100px; margin: 0 auto; position: relative; z-index: 1; }
    .header-back {
        display: inline-flex; align-items: center; gap: 6px;
        font-size: 12px; color: rgba(255,255,255,0.55);
        text-decoration: none; margin-bottom: 14px;
        transition: color .2s;
    }
    .header-back:hover { color: white; }
    .header-label { font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--sage-light); font-weight: 500; margin-bottom: 8px; }
    .header-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 36px; font-weight: 600; color: white; margin: 0;
        display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    }
    .status-pill {
        display: inline-flex; align-items: center; gap: 6px;
        font-family: 'DM Sans', sans-serif;
        font-size: 12px; font-weight: 600; letter-spacing: .06em;
        padding: 4px 12px; border-radius: 20px;
        background: rgba(255,255,255,0.12);
        color: white;
    }

    /* ── LAYOUT ── */
    .detail-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px 60px 80px;
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 32px;
        align-items: start;
    }

    /* ── CARD ── */
    .card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 28px 32px;
        margin-bottom: 24px;
    }
    .card:last-child { margin-bottom: 0; }
    .card-title {
        display: flex; align-items: center; gap: 8px;
        font-family: 'Cormorant Garamond', serif;
        font-size: 20px; font-weight: 600; color: var(--ink);
        margin-bottom: 22px;
    }
    .card-title i { color: var(--sage); font-size: 16px; }

    /* ── ITEMS TABLE ── */
    .items-table { width: 100%; border-collapse: collapse; }
    .items-table th {
        font-size: 11px; font-weight: 600; letter-spacing: .08em;
        text-transform: uppercase; color: var(--muted);
        padding: 0 12px 12px 0;
        border-bottom: 1px solid var(--border);
        text-align: left;
    }
    .items-table th:last-child { text-align: right; padding-right: 0; }
    .items-table td {
        padding: 16px 12px 16px 0;
        border-bottom: 1px solid var(--border);
        vertical-align: middle;
    }
    .items-table td:last-child { text-align: right; padding-right: 0; }
    .items-table tr:last-child td { border-bottom: none; }

    /* product cell */
    .prod-cell { display: flex; align-items: center; gap: 14px; }
    .prod-thumb {
        width: 52px; height: 52px;
        border-radius: 10px;
        background: linear-gradient(145deg, #e0e8e1, #c8d8ca);
        display: flex; align-items: center; justify-content: center;
        font-size: 20px;
        overflow: hidden;
        flex-shrink: 0;
        position: relative;
    }
    .prod-thumb img { width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; border-radius: 10px; }
    .prod-name { font-size: 14px; font-weight: 500; color: var(--ink); line-height: 1.3; }
    .prod-meta { font-size: 12px; color: var(--muted); margin-top: 2px; }

    .type-badge {
        display: inline-block;
        font-size: 10px; font-weight: 600; letter-spacing: .06em;
        padding: 2px 7px; border-radius: 20px; text-transform: uppercase;
    }
    .type-coffee    { background: #fef3e2; color: #b45309; }
    .type-matcha    { background: #ecfdf5; color: #059669; }
    .type-equipment { background: #eef2ff; color: #4f46e5; }

    /* price col */
    .price-col { font-family: 'Cormorant Garamond', serif; font-size: 16px; font-weight: 600; color: var(--sage-dark); }
    .unit-col  { font-size: 13px; color: var(--muted); }
    .qty-col   { font-size: 14px; font-weight: 500; text-align: center; }

    /* ── SUMMARY ── */
    .summary-row {
        display: flex; justify-content: space-between; align-items: center;
        font-size: 13px; color: var(--muted); padding: 7px 0;
    }
    .summary-row.total {
        padding-top: 14px; border-top: 1px solid var(--border);
        font-size: 15px; color: var(--ink); font-weight: 600;
    }
    .summary-row.total .val {
        font-family: 'Cormorant Garamond', serif;
        font-size: 26px; font-weight: 600; color: var(--sage-dark);
    }

    /* ── INFO GRID ── */
    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 24px; }
    .info-item { display: flex; flex-direction: column; gap: 3px; }
    .info-label { font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
    .info-val   { font-size: 14px; color: var(--ink); line-height: 1.4; }
    .info-item.full { grid-column: 1 / -1; }

    /* ── STATUS UPDATE ── */
    .status-form { display: flex; flex-direction: column; gap: 10px; }
    .status-select {
        width: 100%;
        height: 44px;
        border: 1.5px solid var(--border);
        border-radius: 10px;
        padding: 0 14px;
        font-size: 14px;
        font-family: 'DM Sans', sans-serif;
        color: var(--ink);
        background: var(--cream);
        outline: none;
        cursor: pointer;
    }
    .status-select:focus { border-color: var(--sage); }
    .btn-update {
        height: 44px;
        border: none;
        border-radius: 10px;
        background: var(--sage-dark);
        color: white;
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all .2s;
        display: flex; align-items: center; justify-content: center; gap: 6px;
    }
    .btn-update:hover { background: var(--sage); transform: translateY(-1px); }

    /* status timeline */
    .timeline { display: flex; flex-direction: column; gap: 0; margin-top: 4px; }
    .tl-item  { display: flex; align-items: flex-start; gap: 12px; padding-bottom: 16px; position: relative; }
    .tl-item:last-child { padding-bottom: 0; }
    .tl-item:not(:last-child) .tl-line {
        position: absolute; left: 11px; top: 24px;
        width: 2px; height: calc(100% - 8px);
        background: var(--border);
    }
    .tl-dot {
        width: 24px; height: 24px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0; font-size: 11px; margin-top: 1px;
    }
    .tl-dot.active   { background: var(--sage-dark); color: white; }
    .tl-dot.done     { background: #dcfce7; color: var(--success); }
    .tl-dot.upcoming { background: var(--border); color: var(--muted); }
    .tl-label { font-size: 13px; color: var(--ink); font-weight: 500; line-height: 1; margin-top: 4px; }
    .tl-sub   { font-size: 11px; color: var(--muted); margin-top: 3px; }

    @@media (max-width: 900px) {
        .detail-page { grid-template-columns: 1fr; padding: 28px 24px 60px; }
        .page-header { padding: 36px 24px 32px; }
    }
</style>

<!-- PAGE HEADER -->
<div class="page-header">
    <div class="header-inner">
        <a href="/Admin/Orders" class="header-back">
            <i class="bi bi-arrow-left"></i> Back to Orders
        </a>
        <div class="header-label">Order Management</div>
        <h1 class="header-title">
            #@Model.OrderId!.Substring(0, 8).ToUpper()
            <span class="status-pill">
                <i class="bi bi-@statusIcon"></i>
                @statusLabel
            </span>
        </h1>
    </div>
</div>

<div class="detail-page">

    <!-- ── LEFT: ITEMS + SUMMARY ── -->
    <div>

        <!-- Alert messages -->
        @if (TempData["Success"] != null)
        {
            <div style="background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46;border-radius:12px;padding:12px 18px;margin-bottom:20px;display:flex;align-items:center;gap:8px;font-size:13px;">
                <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
            </div>
        }

        <!-- Order Items -->
        <div class="card">
            <div class="card-title">
                <i class="bi bi-bag-fill"></i>
                Order Items
                <span style="margin-left:auto;font-family:'DM Sans',sans-serif;font-size:13px;color:var(--muted);font-weight:400;">
                    @Model.OrdersItems.Count item@(Model.OrdersItems.Count != 1 ? "s" : "")
                </span>
            </div>

            <table class="items-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Unit</th>
                        <th style="text-align:center">Qty</th>
                        <th style="text-align:right">Unit Price</th>
                        <th style="text-align:right">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var oi in Model.OrdersItems)
                    {
                        var opt  = oi.ProductOption;
                        var prod = opt?.Product;
                        var pType = prod?.ProductType?.ToLower() ?? "";
                        var typeClass = pType == "coffee" ? "type-coffee"
                                      : pType == "matcha" ? "type-matcha"
                                      : "type-equipment";
                        var emoji = pType == "coffee" ? "☕"
                                  : pType == "matcha" ? "🍵"
                                  : "⚙️";
                        string imgUrl = pType.Contains("coffee")
                            ? Url.Content("~/images/coffee-beans.jpg")
                            : pType.Contains("matcha")
                            ? Url.Content("~/images/matcha-powder.jpg")
                            : Url.Content("~/images/brewing-equipment.jpg");

                        // Use stored price/amount from order_item; unit price = price / amount
                        decimal unitPrice = (oi.Amount ?? 0) > 0 ? (oi.Price ?? 0) / (oi.Amount ?? 1) : (opt?.ProductPrice ?? 0);

                        <tr>
                            <td>
                                <div class="prod-cell">
                                    <div class="prod-thumb">
                                        <img src="@imgUrl" alt="@prod?.ProductName" onerror="this.style.display='none'" />
                                        <span>@emoji</span>
                                    </div>
                                    <div>
                                        <div class="prod-name">@(prod?.ProductName ?? "—")</div>
                                        <div class="prod-meta">
                                            <span class="type-badge @typeClass">@(prod?.ProductType ?? "—")</span>
                                            @if (prod?.Category != null)
                                            {
                                                <span style="margin-left:4px;font-size:11px;color:var(--muted)">@prod.Category.CategoryName</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="unit-col">@(opt?.ProductAmount?.ToString() ?? "—") @(opt?.ProductUnit ?? "")</td>
                            <td class="qty-col">@oi.Amount</td>
                            <td class="price-col" style="text-align:right">@unitPrice.ToString("N0") ฿</td>
                            <td class="price-col" style="text-align:right">@(oi.Price?.ToString("N0") ?? "—") ฿</td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Summary under items -->
            <div style="margin-top:20px;padding-top:4px">
                <div class="summary-row total">
                    <span>Grand Total</span>
                    <span class="val">@Model.TotalPrice?.ToString("N0") ฿</span>
                </div>
            </div>
        </div>

        <!-- Shipping Info -->
        <div class="card">
            <div class="card-title"><i class="bi bi-geo-alt-fill"></i> Shipping Information</div>
            <div class="info-grid">
                <div class="info-item">
                    <span class="info-label">Recipient</span>
                    <span class="info-val">@(Model.ShippingName ?? "—")</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Phone</span>
                    <span class="info-val">@(Model.ShippingPhone ?? "—")</span>
                </div>
                <div class="info-item full">
                    <span class="info-label">Address</span>
                    <span class="info-val">@(Model.ShippingAddress ?? "—")</span>
                </div>
            </div>
        </div>

        <!-- Customer Info -->
        <div class="card">
            <div class="card-title"><i class="bi bi-person-fill"></i> Customer</div>
            <div class="info-grid">
                <div class="info-item">
                    <span class="info-label">Email</span>
                    <span class="info-val">@(Model.User?.Email ?? "—")</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Phone</span>
                    <span class="info-val">@(Model.User?.Phone ?? "—")</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Order ID</span>
                    <span class="info-val" style="font-size:12px;font-family:monospace">@Model.OrderId</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Ordered At</span>
                    <span class="info-val">@Model.CreatedAt?.ToString("dd MMM yyyy, HH:mm")</span>
                </div>
            </div>
        </div>

    </div>

    <!-- ── RIGHT: STATUS + TIMELINE ── -->
    <div>

        <!-- Update Status -->
        <div class="card">
            <div class="card-title"><i class="bi bi-pencil-square"></i> Update Status</div>

            <form method="post" asp-action="UpdateOrderStatus" asp-controller="Admin" class="status-form">
                <input type="hidden" name="orderId" value="@Model.OrderId" />
                <select name="status" class="status-select">
                    @foreach (var s in allStatuses)
                    {
                        if (s == currentStatus)
                        {
                            <option value="@s" selected>@s</option>
                        }
                        else
                        {
                            <option value="@s">@s</option>
                        }
                    }
                </select>
                <button type="submit" class="btn-update">
                    <i class="bi bi-arrow-repeat"></i> Update Status
                </button>
            </form>
        </div>

        <!-- Status Timeline -->
        <div class="card">
            <div class="card-title"><i class="bi bi-list-check"></i> Order Timeline</div>

            @{
                var timelineSteps = new[]
                {
                    ("PENDING",   "clock-history", "Order placed, awaiting confirmation"),
                    ("CONFIRMED", "check2-circle", "Order confirmed by store"),
                    ("SHIPPED",   "truck",         "Package dispatched"),
                    ("COMPLETED", "bag-check-fill","Delivered successfully"),
                };
                var statusOrder = new[] { "PENDING", "CONFIRMED", "SHIPPED", "COMPLETED" };
                int currentIdx  = Array.IndexOf(statusOrder, currentStatus);
            }

            <div class="timeline">
                @for (int i = 0; i < timelineSteps.Length; i++)
                {
                    var (stepKey, stepIcon, stepDesc) = timelineSteps[i];
                    string dotClass = i < currentIdx  ? "done"
                                    : i == currentIdx ? "active"
                                    : "upcoming";
                    string dotIcon  = i < currentIdx  ? "check-lg" : stepIcon;

                    <div class="tl-item">
                        <div class="tl-dot @dotClass">
                            <i class="bi bi-@dotIcon"></i>
                        </div>
                        <div class="tl-line"></div>
                        <div>
                            <div class="tl-label">@stepKey</div>
                            <div class="tl-sub">@stepDesc</div>
                        </div>
                    </div>
                }

                @if (currentStatus == "CANCELLED")
                {
                    <div class="tl-item">
                        <div class="tl-dot" style="background:#fee2e2;color:#b91c1c">
                            <i class="bi bi-x-lg"></i>
                        </div>
                        <div>
                            <div class="tl-label">CANCELLED</div>
                            <div class="tl-sub">Order was cancelled</div>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
</div>
