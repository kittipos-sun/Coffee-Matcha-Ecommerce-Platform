@model CSI402_Final.Models.DB.User

@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Navbar/_UserNavbar.cshtml";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300&family=DM+Sans:wght@300;400;500&display=swap');

    :root {
        --sage: #5a7a5e;
        --sage-dark: #3d5940;
        --sage-light: #8aab8e;
        --cream: #f7f4ef;
        --warm-white: #fefcf8;
        --ink: #1e2420;
        --muted: #7a8878;
        --border: #d8e0d6;
    }

    .auth-page {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--warm-white);
        font-family: 'DM Sans', sans-serif;
        padding: 40px 20px;
    }

    .auth-panel {
        display: grid;
        grid-template-columns: 1fr 1fr;
        max-width: 820px;
        width: 100%;
        background: white;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 4px 60px rgba(30, 36, 32, 0.10);
        border: 1px solid var(--border);
    }

    .auth-deco {
        background: var(--sage-dark);
        padding: 56px 44px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        overflow: hidden;
    }

    .auth-deco::before {
        content: '';
        position: absolute;
        top: -60px;
        right: -60px;
        width: 220px;
        height: 220px;
        border-radius: 50%;
        background: rgba(255,255,255,0.05);
    }

    .auth-deco::after {
        content: '';
        position: absolute;
        bottom: -40px;
        left: -40px;
        width: 160px;
        height: 160px;
        border-radius: 50%;
        background: rgba(255,255,255,0.04);
    }

    .deco-logo {
        font-family: 'Cormorant Garamond', serif;
        font-size: 22px;
        font-weight: 600;
        color: rgba(255,255,255,0.9);
        letter-spacing: 0.08em;
    }

    .deco-tag {
        font-size: 11px;
        color: var(--sage-light);
        letter-spacing: 0.18em;
        text-transform: uppercase;
        margin-top: 4px;
    }

    .deco-steps {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .deco-step {
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .step-num {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        color: rgba(255,255,255,0.7);
        flex-shrink: 0;
        margin-top: 2px;
    }

    .step-text strong {
        display: block;
        font-size: 14px;
        color: rgba(255,255,255,0.9);
        font-weight: 500;
    }

    .step-text span {
        font-size: 12px;
        color: var(--sage-light);
    }

    .auth-form-wrap {
        padding: 52px 48px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .auth-form-wrap h2 {
        font-family: 'Cormorant Garamond', serif;
        font-size: 30px;
        font-weight: 600;
        color: var(--ink);
        margin: 0 0 4px;
    }

    .auth-form-wrap .sub {
        font-size: 13px;
        color: var(--muted);
        margin-bottom: 28px;
    }

    .field-group {
        margin-bottom: 16px;
    }

    .field-group label {
        display: block;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 7px;
    }

    .field-group input {
        width: 100%;
        height: 46px;
        border: 1.5px solid var(--border);
        border-radius: 10px;
        background: var(--cream);
        padding: 0 16px;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        color: var(--ink);
        outline: none;
        transition: all 0.2s;
        box-sizing: border-box;
    }

    .field-group input:focus {
        border-color: var(--sage);
        background: white;
        box-shadow: 0 0 0 3px rgba(90, 122, 94, 0.10);
    }

    .text-danger {
        font-size: 12px;
        color: #c0392b;
        display: block;
        margin-top: 4px;
    }

    .btn-auth {
        width: 100%;
        height: 48px;
        border: none;
        border-radius: 10px;
        background: var(--sage-dark);
        color: white;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 0.05em;
        cursor: pointer;
        transition: all 0.25s;
        margin-top: 10px;
    }

    .btn-auth:hover {
        background: var(--sage);
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(61, 89, 64, 0.25);
    }

    .auth-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 20px 0 16px;
    }

    .auth-divider span {
        flex: 1;
        height: 1px;
        background: var(--border);
    }

    .auth-divider em {
        font-style: normal;
        font-size: 12px;
        color: var(--muted);
    }

    .auth-footer {
        text-align: center;
        font-size: 13px;
        color: var(--muted);
    }

    .auth-footer a {
        color: var(--sage-dark);
        font-weight: 500;
        text-decoration: none;
    }

    .auth-footer a:hover { text-decoration: underline; }

    .error-msg {
        font-size: 13px;
        color: #c0392b;
        background: #fff0ef;
        border: 1px solid #f5c6c3;
        border-radius: 8px;
        padding: 10px 14px;
        margin-top: 10px;
    }

    @@media (max-width: 640px) {
        .auth-panel { grid-template-columns: 1fr; }
        .auth-deco { display: none; }
        .auth-form-wrap { padding: 40px 28px; }
    }
</style>

<div class="auth-page">
    <div class="auth-panel">

        <!-- Decorative Left Panel -->
        <div class="auth-deco">
            <div>
                <div class="deco-logo">☕ MatchaBrew</div>
                <div class="deco-tag">Join Our Community</div>
            </div>
            <div class="deco-steps">
                <div class="deco-step">
                    <div class="step-num">1</div>
                    <div class="step-text">
                        <strong>Create your account</strong>
                        <span>Takes less than a minute</span>
                    </div>
                </div>
                <div class="deco-step">
                    <div class="step-num">2</div>
                    <div class="step-text">
                        <strong>Explore our collection</strong>
                        <span>Coffee, matcha & equipment</span>
                    </div>
                </div>
                <div class="deco-step">
                    <div class="step-num">3</div>
                    <div class="step-text">
                        <strong>Begin your ritual</strong>
                        <span>Delivered to your door</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Form Panel -->
        <div class="auth-form-wrap">
            <h2>Create account</h2>
            <p class="sub">Begin your craft coffee journey today</p>

            <form asp-action="Register" asp-controller="Auth" method="post">

                <div class="field-group">
                    <label>Email</label>
                    <input asp-for="Email" type="email" placeholder="you@example.com" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="field-group">
                    <label>Phone</label>
                    <input asp-for="Phone" type="tel" placeholder="0XX-XXX-XXXX" required />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="field-group">
                    <label>Password</label>
                    <input asp-for="Password" type="password" placeholder="••••••••" required />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-auth">Create Account</button>

            </form>

            @if (ViewBag.Error != null)
            {
                <div class="error-msg">@ViewBag.Error</div>
            }

            <div class="auth-divider">
                <span></span>
                <em>or</em>
                <span></span>
            </div>

            <div class="auth-footer">
                Already have an account?
                <a asp-controller="Auth" asp-action="Login">Sign in →</a>
            </div>
        </div>

    </div>
</div>
