@model CSI402_Final.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Navbar/_UserNavbar.cshtml";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300&family=DM+Sans:wght@300;400;500&display=swap');

    :root {
        --sage: #5a7a5e;
        --sage-dark: #3d5940;
        --sage-light: #8aab8e;
        --cream: #f7f4ef;
        --warm-white: #fefcf8;
        --ink: #1e2420;
        --muted: #7a8878;
        --border: #d8e0d6;
    }

    .auth-page {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--warm-white);
        font-family: 'DM Sans', sans-serif;
        padding: 40px 20px;
    }

    .auth-panel {
        display: grid;
        grid-template-columns: 1fr 1fr;
        max-width: 820px;
        width: 100%;
        background: white;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 4px 60px rgba(30, 36, 32, 0.10);
        border: 1px solid var(--border);
    }

    /* Left decorative panel */
    .auth-deco {
        background: var(--sage-dark);
        padding: 56px 44px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        overflow: hidden;
    }

    .auth-deco::before {
        content: '';
        position: absolute;
        top: -60px;
        right: -60px;
        width: 220px;
        height: 220px;
        border-radius: 50%;
        background: rgba(255,255,255,0.05);
    }

    .auth-deco::after {
        content: '';
        position: absolute;
        bottom: -40px;
        left: -40px;
        width: 160px;
        height: 160px;
        border-radius: 50%;
        background: rgba(255,255,255,0.04);
    }

    .deco-logo {
        font-family: 'Cormorant Garamond', serif;
        font-size: 22px;
        font-weight: 600;
        color: rgba(255,255,255,0.9);
        letter-spacing: 0.08em;
    }

    .deco-tag {
        font-size: 11px;
        color: var(--sage-light);
        letter-spacing: 0.18em;
        text-transform: uppercase;
        margin-top: 4px;
    }

    .deco-quote {
        font-family: 'Cormorant Garamond', serif;
        font-size: 28px;
        font-weight: 300;
        font-style: italic;
        color: rgba(255,255,255,0.88);
        line-height: 1.5;
    }

    .deco-jp {
        font-size: 12px;
        color: var(--sage-light);
        margin-top: 12px;
        letter-spacing: 0.1em;
    }

    /* Right form panel */
    .auth-form-wrap {
        padding: 52px 48px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .auth-form-wrap h2 {
        font-family: 'Cormorant Garamond', serif;
        font-size: 30px;
        font-weight: 600;
        color: var(--ink);
        margin: 0 0 4px;
    }

    .auth-form-wrap .sub {
        font-size: 13px;
        color: var(--muted);
        margin-bottom: 32px;
    }

    .field-group {
        margin-bottom: 18px;
    }

    .field-group label {
        display: block;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 7px;
    }

    .field-group input {
        width: 100%;
        height: 46px;
        border: 1.5px solid var(--border);
        border-radius: 10px;
        background: var(--cream);
        padding: 0 16px;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        color: var(--ink);
        outline: none;
        transition: all 0.2s;
        box-sizing: border-box;
    }

    .field-group input:focus {
        border-color: var(--sage);
        background: white;
        box-shadow: 0 0 0 3px rgba(90, 122, 94, 0.10);
    }

    .btn-auth {
        width: 100%;
        height: 48px;
        border: none;
        border-radius: 10px;
        background: var(--sage-dark);
        color: white;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 0.05em;
        cursor: pointer;
        transition: all 0.25s;
        margin-top: 8px;
    }

    .btn-auth:hover {
        background: var(--sage);
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(61, 89, 64, 0.25);
    }

    .auth-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 24px 0 18px;
    }

    .auth-divider span {
        flex: 1;
        height: 1px;
        background: var(--border);
    }

    .auth-divider em {
        font-style: normal;
        font-size: 12px;
        color: var(--muted);
    }

    .auth-footer {
        text-align: center;
        font-size: 13px;
        color: var(--muted);
    }

    .auth-footer a {
        color: var(--sage-dark);
        font-weight: 500;
        text-decoration: none;
    }

    .auth-footer a:hover {
        text-decoration: underline;
    }

    .error-msg {
        font-size: 13px;
        color: #c0392b;
        background: #fff0ef;
        border: 1px solid #f5c6c3;
        border-radius: 8px;
        padding: 10px 14px;
        margin-top: 12px;
    }

    @@media (max-width: 640px) {
        .auth-panel { grid-template-columns: 1fr; }
        .auth-deco { display: none; }
        .auth-form-wrap { padding: 40px 28px; }
    }
</style>

<div class="auth-page">
    <div class="auth-panel">

        <!-- Decorative Left Panel -->
        <div class="auth-deco">
            <div>
                <div class="deco-logo">☕ MatchaBrew</div>
                <div class="deco-tag">Japanese Craftsmanship</div>
            </div>
            <div>
                <div class="deco-quote">"Every cup is a quiet ritual — a moment of stillness in a busy world."</div>
                <div class="deco-jp">静けさの一杯</div>
            </div>
        </div>

        <!-- Form Panel -->
        <div class="auth-form-wrap">
            <h2>Welcome back</h2>
            <p class="sub">Sign in to continue your journey</p>

            <form asp-action="Login" asp-controller="Auth" method="post">

                <div class="field-group">
                    <label>Email</label>
                    <input asp-for="Email" type="email" placeholder="you@example.com" />
                </div>

                <div class="field-group">
                    <label>Password</label>
                    <input asp-for="Password" type="password" placeholder="••••••••" />
                </div>

                <button type="submit" class="btn-auth">Sign In</button>

            </form>

            @if (ViewBag.Error != null)
            {
                <div class="error-msg">@ViewBag.Error</div>
            }

            <div class="auth-divider">
                <span></span>
                <em>or</em>
                <span></span>
            </div>

            <div class="auth-footer">
                Don't have an account?
                <a href="/Auth/Register">Create one →</a>
            </div>
        </div>

    </div>
</div>
