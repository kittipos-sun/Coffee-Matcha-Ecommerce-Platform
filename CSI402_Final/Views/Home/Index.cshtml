@model List<CSI402_Final.Models.DB.Product>

@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Navbar/_UserNavbar.cshtml";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap');

    :root {
        --sage: #5a7a5e;
        --sage-dark: #3d5940;
        --sage-light: #8aab8e;
        --cream: #f7f4ef;
        --warm-white: #fefcf8;
        --ink: #1e2420;
        --muted: #7a8878;
        --border: #d8e0d6;
        --section-bg: #f3f0eb;
    }

    body { font-family: 'DM Sans', sans-serif; background: var(--warm-white); color: var(--ink); }

    /* ─── HERO ─── */
    .hero {
        min-height: 88vh;
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        background: var(--warm-white);
        padding: 0 60px;
        position: relative;
        overflow: hidden;
    }

    .hero::after {
        content: '';
        position: absolute;
        right: -100px;
        top: 50%;
        transform: translateY(-50%);
        width: 520px;
        height: 520px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(90,122,94,0.14) 0%, transparent 70%);
        pointer-events: none;
    }

    .hero-tag {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 11px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--sage);
        font-weight: 500;
        margin-bottom: 20px;
    }

    .hero-tag::before {
        content: '';
        display: inline-block;
        width: 24px;
        height: 1px;
        background: var(--sage);
    }

    .hero h1 {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(44px, 5vw, 68px);
        font-weight: 600;
        line-height: 1.08;
        color: var(--ink);
        margin: 0 0 20px;
    }

    .hero h1 em {
        font-style: italic;
        color: var(--sage);
    }

    .hero-sub {
        font-size: 15px;
        color: var(--muted);
        line-height: 1.7;
        max-width: 420px;
        margin-bottom: 36px;
        font-weight: 300;
    }

    .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--sage-dark);
        color: white;
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        font-weight: 500;
        letter-spacing: 0.04em;
        padding: 14px 28px;
        border-radius: 100px;
        text-decoration: none;
        transition: all 0.25s;
        border: none;
    }

    .btn-primary:hover {
        background: var(--sage);
        transform: translateY(-2px);
        box-shadow: 0 10px 28px rgba(61, 89, 64, 0.22);
        color: white;
        text-decoration: none;
    }

    .btn-outline {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 1.5px solid var(--border);
        color: var(--ink);
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        font-weight: 500;
        padding: 14px 28px;
        border-radius: 100px;
        text-decoration: none;
        transition: all 0.25s;
    }

    .btn-outline:hover {
        border-color: var(--sage);
        color: var(--sage-dark);
        text-decoration: none;
        transform: translateY(-2px);
    }

    .hero-visual {
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        z-index: 1;
    }

    .hero-circle {
        width: 380px;
        height: 380px;
        border-radius: 50%;
        background: linear-gradient(145deg, #e8ede9, #c8d8ca);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 120px;
        box-shadow: 0 20px 60px rgba(61,89,64,0.15);
        animation: float 6s ease-in-out infinite;
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-12px); }
    }

    /* ─── STATS ─── */
    .stats-bar {
        background: var(--sage-dark);
        padding: 28px 60px;
        display: flex;
        justify-content: space-around;
        align-items: center;
    }

    .stat { text-align: center; }

    .stat-num {
        font-family: 'Cormorant Garamond', serif;
        font-size: 32px;
        font-weight: 600;
        color: white;
        line-height: 1;
    }

    .stat-label {
        font-size: 12px;
        color: var(--sage-light);
        letter-spacing: 0.1em;
        margin-top: 4px;
    }

    .stat-sep {
        width: 1px;
        height: 40px;
        background: rgba(255,255,255,0.15);
    }

    /* ─── SECTION HEADER ─── */
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 36px;
    }

    .section-label {
        font-size: 11px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--sage);
        font-weight: 500;
        margin-bottom: 8px;
    }

    .section-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 36px;
        font-weight: 600;
        color: var(--ink);
        margin: 0;
    }

    /* ─── CATEGORY ─── */
    .section-collections { padding: 80px 60px; background: var(--warm-white); }

    .cat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }

    .cat-card {
        border-radius: 20px;
        overflow: hidden;
        position: relative;
        cursor: pointer;
        height: 280px;
        text-decoration: none;
        display: block;
    }

    .cat-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .cat-card:hover img { transform: scale(1.06); }

    .cat-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(20,30,22,0.75) 0%, rgba(0,0,0,0.1) 55%);
        padding: 24px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
    }

    .cat-name {
        font-family: 'Cormorant Garamond', serif;
        font-size: 24px;
        font-weight: 600;
        color: white;
        line-height: 1.1;
    }

    .cat-sub {
        font-size: 12px;
        color: rgba(255,255,255,0.7);
        margin-top: 4px;
        letter-spacing: 0.04em;
    }

    /* ─── FEATURED PRODUCTS ─── */
    .section-products { padding: 80px 60px; background: var(--section-bg); }

    .product-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }

    .product-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid var(--border);
        transition: all 0.28s;
        text-decoration: none;
        display: block;
        color: var(--ink);
    }

    .product-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 16px 40px rgba(30,36,32,0.10);
        text-decoration: none;
        color: var(--ink);
    }

    .product-img {
        height: 200px;
        overflow: hidden;
        position: relative;
    }

    .product-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s;
    }

    .product-card:hover .product-img img { transform: scale(1.04); }

    .product-type-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: rgba(255,255,255,0.9);
        font-size: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--sage-dark);
        font-weight: 500;
        padding: 4px 10px;
        border-radius: 100px;
    }

    .product-body { padding: 18px 18px 20px; }

    .product-name {
        font-family: 'Cormorant Garamond', serif;
        font-size: 18px;
        font-weight: 600;
        color: var(--ink);
        line-height: 1.2;
        margin-bottom: 10px;
    }

    .product-price {
        font-size: 16px;
        font-weight: 500;
        color: var(--sage-dark);
    }

    .product-cta {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 12px;
        font-weight: 500;
        color: var(--sage);
        margin-top: 12px;
        letter-spacing: 0.04em;
    }

    /* ─── FEATURES ─── */
    .section-features { padding: 80px 60px; background: var(--warm-white); }

    .features-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }

    .feature-item { text-align: center; }

    .feature-icon {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: var(--cream);
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin: 0 auto 16px;
    }

    .feature-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 20px;
        font-weight: 600;
        color: var(--ink);
        margin-bottom: 8px;
    }

    .feature-desc { font-size: 14px; color: var(--muted); line-height: 1.6; }

    /* ─── CTA ─── */
    .section-cta {
        background: var(--sage-dark);
        padding: 100px 60px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .section-cta::before {
        content: '';
        position: absolute;
        top: -80px;
        left: 50%;
        transform: translateX(-50%);
        width: 600px;
        height: 600px;
        border-radius: 50%;
        background: rgba(255,255,255,0.04);
        pointer-events: none;
    }

    .cta-jp {
        font-size: 12px;
        letter-spacing: 0.2em;
        color: var(--sage-light);
        text-transform: uppercase;
        margin-bottom: 16px;
    }

    .cta-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(36px, 4vw, 52px);
        font-weight: 600;
        color: white;
        margin-bottom: 16px;
    }

    .cta-sub {
        font-size: 15px;
        color: rgba(255,255,255,0.65);
        margin-bottom: 36px;
        font-weight: 300;
    }

    .btn-cta {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: white;
        color: var(--sage-dark);
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        font-weight: 500;
        padding: 15px 32px;
        border-radius: 100px;
        text-decoration: none;
        transition: all 0.25s;
    }

    .btn-cta:hover {
        background: var(--cream);
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(0,0,0,0.2);
        text-decoration: none;
        color: var(--sage-dark);
    }

    /* ─── LINK OVERRIDES ─── */
    a { text-decoration: none; }

    @@media (max-width: 900px) {
        .hero { grid-template-columns: 1fr; padding: 60px 28px; min-height: auto; }
        .hero-visual { display: none; }
        .cat-grid, .product-grid, .features-grid { grid-template-columns: 1fr 1fr; }
        .stats-bar, .section-collections, .section-products, .section-features, .section-cta { padding: 60px 28px; }
    }

    @@media (max-width: 580px) {
        .cat-grid, .product-grid { grid-template-columns: 1fr; }
        .features-grid { grid-template-columns: 1fr; gap: 28px; }
    }
</style>

<section class="hero">
    <div class="hero-content">
        <div class="hero-tag">日本のこだわり · Japanese Craftsmanship</div>

        <h1>
            Mindful moments,<br />
            <em>perfectly brewed.</em>
        </h1>

        <p class="hero-sub">
            Premium coffee beans and ceremonial-grade matcha,
            thoughtfully sourced from Japan and beyond.
        </p>

        <div class="hero-actions">
            <a href="/Product" class="btn-primary">Shop Collection →</a>
            <a href="/Product?category=matcha" class="btn-outline">Explore Matcha</a>
        </div>
    </div>

    <div class="hero-visual">
        <div class="hero-circle">🍵</div>
    </div>
</section>

<div class="stats-bar">
    <div class="stat">
        <div class="stat-num">500+</div>
        <div class="stat-label">Products</div>
    </div>
    <div class="stat-sep"></div>
    <div class="stat">
        <div class="stat-num">12</div>
        <div class="stat-label">Origins</div>
    </div>
    <div class="stat-sep"></div>
    <div class="stat">
        <div class="stat-num">100%</div>
        <div class="stat-label">Direct Trade</div>
    </div>
    <div class="stat-sep"></div>
    <div class="stat">
        <div class="stat-num">3</div>
        <div class="stat-label">Collections</div>
    </div>
</div>

<section class="section-collections">
    <div class="section-header">
        <div>
            <div class="section-label">Our Selection</div>
            <h2 class="section-title">Our Collections</h2>
        </div>
        <a href="/Product" class="btn-outline" style="font-size:12px; padding:10px 22px;">View All →</a>
    </div>

    <div class="cat-grid">
        <a asp-controller="Product" asp-action="Index" asp-route-category="Coffee Beans" class="cat-card">
            <img src="~/images/coffee-beans.jpg" alt="Coffee" />
            <div class="cat-overlay">
                <div class="cat-name">Coffee</div>
                <div class="cat-sub">Premium roasted beans</div>
            </div>
        </a>

        <a asp-controller="Product" asp-action="Index" asp-route-category="Matcha" class="cat-card">
            <img src="~/images/matcha-powder.jpg" alt="Matcha" />
            <div class="cat-overlay">
                <div class="cat-name">Matcha</div>
                <div class="cat-sub">Japanese green tea</div>
            </div>
        </a>

        <a asp-controller="Product" asp-action="Index" asp-route-category="Equipment" class="cat-card">
            <img src="~/images/brewing-equipment.jpg" alt="Equipment" />
            <div class="cat-overlay">
                <div class="cat-name">Equipment</div>
                <div class="cat-sub">Brewing tools</div>
            </div>
        </a>
    </div>
</section>

<section class="section-products">
    <div class="section-header">
        <div>
            <div class="section-label">Handpicked</div>
            <h2 class="section-title">Featured Products</h2>
        </div>
        <a href="/Product" class="btn-outline" style="font-size:12px; padding:10px 22px;">View All →</a>
    </div>

    <div class="product-grid">
        @foreach (var item in Model)
        {
            var type = item.ProductType?.ToLower() ?? "";

            string imageUrl = type.Contains("coffee")
                ? Url.Content("~/images/coffee-beans.jpg")
                : type.Contains("matcha")
                ? Url.Content("~/images/matcha-powder.jpg")
                : Url.Content("~/images/brewing-equipment.jpg");

            var price = item.ProductOptions?.FirstOrDefault()?.ProductPrice ?? 0;

            <a href="/Product/Detail/@item.ProductId" class="product-card">
                <div class="product-img">
                    <img src="@imageUrl" alt="@item.ProductName" onerror="this.src='~/images/default.jpg'" />
                    <div class="product-type-badge">@item.ProductType</div>
                </div>
                <div class="product-body">
                    <div class="product-name">@item.ProductName</div>
                    <div class="product-price">@price.ToString("N0") ฿</div>
                    <div class="product-cta">View details →</div>
                </div>
            </a>
        }
    </div>
</section>

<section class="section-features">
    <div class="section-header" style="justify-content:center; text-align:center; flex-direction:column; align-items:center; gap:8px; margin-bottom:52px;">
        <div class="section-label">Why Choose Us</div>
        <h2 class="section-title">Our Promise</h2>
    </div>

    <div class="features-grid">
        <div class="feature-item">
            <div class="feature-icon">🌱</div>
            <div class="feature-title">Sustainably Sourced</div>
            <p class="feature-desc">Direct trade partnerships with farmers who share our commitment to the earth.</p>
        </div>
        <div class="feature-item">
            <div class="feature-icon">🔥</div>
            <div class="feature-title">Freshly Roasted</div>
            <p class="feature-desc">Small-batch roasting in-house, ensuring peak flavor in every order.</p>
        </div>
        <div class="feature-item">
            <div class="feature-icon">♻️</div>
            <div class="feature-title">Mindful Packaging</div>
            <p class="feature-desc">Eco-friendly materials that care for the planet as much as your cup.</p>
        </div>
    </div>
</section>

<section class="section-cta">
    <div class="cta-jp">始めましょう · Start Today</div>
    <h2 class="cta-title">Begin Your Daily Ritual</h2>
    <p class="cta-sub">Join a growing community of coffee & matcha lovers across Thailand</p>
    <a href="/Product" class="btn-cta">Browse the Collection →</a>
</section>
